---
import { Picture } from 'astro:assets'
import { GALERIA, REVISION } from '../data/local'
---

<section class="galeria" aria-labelledby="galeria-titulo">
  <header class="cabeza">
    <h2 class="display titulo" id="galeria-titulo">El ambiente</h2>
    {REVISION && <p class="label aviso">Fotos de referencia. Se reemplazan por las del local.</p>}
  </header>
  <div class="grid">
    {
      GALERIA.map((g) => (
        <figure class={`foto area-${g.area}`}>
          <Picture src={g.src} alt={g.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[500, 900, 1400]} sizes="(max-width: 47.99rem) 80vw, 40vw" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .galeria { padding-top: var(--s-seccion); }
  .cabeza {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
    padding: 0 var(--gutter) var(--s-5);
  }
  .titulo { max-width: 12ch; font-size: var(--t-display); font-stretch: 62%; }
  .aviso { max-width: 24ch; text-align: right; color: var(--texto-secundario); }

  /* Full bleed asimétrico, de borde a borde */
  .grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: 30vw 22vw;
    grid-template-areas:
      'a b c'
      'a d d';
    gap: 4px;
  }
  .foto { overflow: hidden; background: var(--superficie); }
  .foto :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-ui); }
  .foto:hover :global(img) { transform: scale(1.04); }
  .area-a { grid-area: a; }
  .area-b { grid-area: b; }
  .area-c { grid-area: c; }
  .area-d { grid-area: d; }

  @media (max-width: 64rem) {
    .grid { grid-template-columns: 1fr 1fr; grid-template-rows: 50vw 40vw; grid-template-areas: 'a b' 'c d'; }
  }
  @media (max-width: 47.99rem) {
    .cabeza { flex-direction: column; align-items: flex-start; }
    .aviso { text-align: left; }
    /* Mobile: carrusel con snap en vez de cuadrícula apilada */
    .grid {
      display: flex;
      gap: var(--s-1);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .foto { flex: 0 0 80vw; height: 62svh; scroll-snap-align: center; border-radius: var(--radio-media); }
  }
</style>
