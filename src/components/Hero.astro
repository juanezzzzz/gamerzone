---
import { NEGOCIO, SEDES, HORARIO, TARIFAS, waLink } from '../data/local'
import { url } from '../lib/url'
const desde = TARIFAS[0].filas[0]
---

<section class="hero" id="hero" data-hero data-horario={JSON.stringify(HORARIO.dias)}>
  <div class="escena" data-hero-escena>
    <div class="ventana" data-hero-ventana>
      <video src={url('/media/piso1-sala.mp4')} poster={url('/media/piso1-sala-poster.webp')} muted loop playsinline autoplay preload="metadata"></video>
      <div class="sombra"></div>
    </div>

    <p class="label ubicacion">
      Sala de videojuegos · {NEGOCIO.lema}
    </p>

    <h1 class="marca" data-hero-marca>
      <span>Gamer</span>
      <span>Zone</span>
    </h1>

    <div class="pie" data-hero-pie>
      <!-- Lo esencial de un vistazo: la página también tiene que informar rápido -->
      <dl class="rapidos">
        <div>
          <dt class="label">Sedes</dt>
          <dd>{SEDES.length} en {NEGOCIO.ciudad.texto}</dd>
        </div>
        <div>
          <dt class="label" data-hero-estado-label>Horario</dt>
          <dd class:list={{ pendiente: HORARIO.pendiente }} data-hero-estado>10:00 – 22:00</dd>
        </div>
        <div>
          <dt class="label">PC gamer desde</dt>
          <dd class:list={{ pendiente: desde.pendiente }}>{desde.precio} / hora</dd>
        </div>
        <div>
          <dt class="label">Viernes y sábado</dt>
          <dd>Transnochón</dd>
        </div>
      </dl>
      <div class="fila-pie">
      <p class="lead">PCs gamer, Xbox 360, One y Series S, y una sala VIP privada. Pagas por hora, con aire acondicionado y servicio en tu puesto.</p>
      <div class="acciones">
        <a class="btn" href={waLink()} target="_blank" rel="noopener">Reservar sesión</a>
        <a class="btn btn-ghost" href="#tarifas">Ver tarifas</a>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { estadoHoy, type DiaHorario } from '../lib/horario'
  const hero = document.querySelector<HTMLElement>('[data-hero]')
  if (hero) {
    const estado = estadoHoy(JSON.parse(hero.dataset.horario || '[]') as DiaHorario[])
    const label = hero.querySelector('[data-hero-estado-label]')
    const valor = hero.querySelector('[data-hero-estado]')
    if (label) label.textContent = estado.abierto ? 'Abierto ahora' : 'Cerrado ahora'
    if (valor) valor.textContent = estado.corto
  }
</script>

<style>
  .escena {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(ellipse 50% 60% at 75% 40%, var(--halo-magenta), transparent 70%),
      radial-gradient(ellipse 45% 50% at 15% 85%, var(--halo-cian), transparent 70%);
  }

  /* La foto entra como una ventana a la derecha y se abre a pantalla completa con el scroll */
  .ventana {
    position: absolute;
    inset: 0;
    clip-path: inset(14% var(--gutter) 30% 42% round var(--radio-media));
  }
  .ventana video { width: 100%; height: 100%; object-fit: cover; }
  .sombra {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(5 7 10 / 0.9), transparent 55%);
  }

  .ubicacion {
    position: absolute;
    top: calc(var(--nav-h) + var(--s-5));
    left: var(--gutter);
  }

  .marca {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(13rem, 30vh, 17rem);
    display: grid;
    font: 900 var(--t-mega) / 0.8 var(--f-display);
    font-stretch: var(--stretch-condensado);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    pointer-events: none;
  }
  /* "GAMER" lleva el degradado RGB con su propio brillo */
  .marca span:last-child {
    background: var(--rgb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 28px rgb(47 224 255 / 0.35)) drop-shadow(0 0 60px rgb(255 47 166 / 0.25));
  }

  .pie {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--s-4);
    display: grid;
    gap: var(--s-3);
  }
  /* Franja de datos rápidos, con hairlines como las cifras */
  .rapidos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgb(238 246 255 / 0.15);
  }
  .rapidos div { display: grid; gap: 0.35rem; padding: var(--s-2) var(--s-2) 0 0; }
  .rapidos div + div { padding-left: var(--s-2); border-left: 1px solid rgb(238 246 255 / 0.1); }
  .rapidos dd { font: 700 var(--t-xl) / 1.1 var(--f-display); font-stretch: 70%; text-transform: uppercase; }
  .fila-pie {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
  }
  .pie .lead { color: var(--texto); }
  .acciones { display: flex; gap: var(--s-2); flex-wrap: wrap; }

  @media (max-width: 64rem) {
    .fila-pie { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 47.99rem) {
    .ventana { clip-path: inset(calc(var(--nav-h) + 3.5rem) var(--gutter) 48% var(--gutter) round var(--radio-media)); }
    .ubicacion { top: calc(var(--nav-h) + var(--s-2)); }
    .marca { bottom: 15.5rem; font-size: clamp(4.5rem, 27vw, 9rem); }
    .pie { bottom: var(--s-4); }
    .rapidos { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s-1); }
    .rapidos div + div:nth-child(3) { padding-left: 0; border-left: 0; }
    .rapidos dd { font-size: var(--t-l); }
    .pie .lead { display: none; }
    .acciones { display: none; }
  }
</style>
