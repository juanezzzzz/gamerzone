---
import { SEDES, HORARIO, PRECIO_HORA_PC, TEXTOS, PORTADA_MEDIA } from '../data/local'
import Icono from './Icono.astro'
---

<section class="hero" id="hero" data-hero data-horario={JSON.stringify(HORARIO.dias)}>
  <div class="contenedor intro">
    <h1 class="titulo-xl" data-hero-titulo>{TEXTOS.portada.titulo}</h1>
    <p class="lead" data-hero-pieza>{TEXTOS.portada.texto}</p>
    <div class="acciones" data-hero-pieza>
      <a class="btn" href="#reserva">Reservar sesión</a>
      <a class="btn btn-ghost" href="#precios">Ver precios</a>
    </div>

    <!-- Lo esencial de un vistazo -->
    <dl class="rapidos" data-hero-pieza>
      <div>
        <dt class="visually-hidden">Estado</dt>
        <dd class:list={['estado', { pendiente: HORARIO.pendiente }]} data-hero-estado>Horario 10:00 – 22:00</dd>
      </div>
      <div>
        <dt class="visually-hidden">PC gamer</dt>
        <dd><Icono nombre="monitor" /><span>PC desde <span class:list={{ pendiente: PRECIO_HORA_PC.pendiente }}>{PRECIO_HORA_PC.texto}</span>/h</span></dd>
      </div>
      <div>
        <dt class="visually-hidden">Sedes</dt>
        <dd><Icono nombre="mapa" />{SEDES.length} sedes</dd>
      </div>
      <div>
        <dt class="visually-hidden">Viernes y sábado</dt>
        <dd><Icono nombre="noche" />Transnochón vie y sáb</dd>
      </div>
    </dl>
  </div>

  <!-- La sala entra como tarjeta y se abre a pantalla completa con el scroll -->
  <div class="media" data-hero-media>
    <video src={PORTADA_MEDIA.video} poster={PORTADA_MEDIA.poster} muted loop playsinline autoplay preload="metadata" aria-label="Sala de PCs de GamerZone"></video>
  </div>
</section>

<script>
  import { estadoHoy, type DiaHorario } from '../lib/horario'
  const hero = document.querySelector<HTMLElement>('[data-hero]')
  const valor = hero?.querySelector<HTMLElement>('[data-hero-estado]')
  if (hero && valor) {
    const estado = estadoHoy(JSON.parse(hero.dataset.horario || '[]') as DiaHorario[])
    valor.textContent = `${estado.abierto ? 'Abierto' : 'Cerrado'} · ${estado.corto}`
    valor.toggleAttribute('data-abierto', estado.abierto)
  }
</script>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + clamp(3rem, 9vh, 6rem));
    overflow: clip;
  }
  .intro {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
  }
  .intro .titulo-xl { max-width: 13ch; }
  .intro .lead { max-width: 52ch; }
  .acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: var(--s-1); }

  .rapidos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-3);
    font: 600 var(--t-s) / 1.3 var(--f-sans);
    color: var(--sobre-oscuro-2);
  }
  .rapidos dd { display: inline-flex; align-items: center; gap: 0.5rem; }
  .rapidos :global(.icono) { width: 1.1rem; height: 1.1rem; color: var(--sobre-oscuro); }
  .rapidos .estado { color: var(--sobre-oscuro); }

  .media {
    height: min(100svh, 62rem);
    margin-top: clamp(3rem, 7vh, 4.5rem);
    /* La tarjeta empieza con el ancho del contenedor y bordes redondeados */
    clip-path: inset(0 max(var(--gutter), (100% - var(--ancho-max)) / 2) round var(--radio-l));
  }
  .media video { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 47.99rem) {
    .hero { padding-top: calc(var(--nav-h) + var(--s-5)); }
    .rapidos { display: grid; grid-template-columns: repeat(2, auto); justify-content: center; text-align: left; gap: var(--s-2) var(--s-3); }
    .acciones { width: 100%; }
    .acciones .btn { flex: 1; }
    .media { height: 70svh; }
  }
</style>
