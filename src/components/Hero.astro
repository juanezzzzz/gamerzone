---
import { NEGOCIO, SEDES, HORARIO, PRECIO_HORA_PC, TEXTOS, PORTADA_MEDIA } from '../data/local'
// Si el título tiene coma, corta la línea ahí
const [inicio, ...resto] = TEXTOS.portada.titulo.split(', ')
---

<section class="hero" id="inicio" data-hero data-horario={JSON.stringify(HORARIO.dias)}>
  <!-- La sala a pantalla completa: es lo primero que se ve -->
  <div class="fondo" data-hero-fondo>
    <video src={PORTADA_MEDIA.video} poster={PORTADA_MEDIA.poster} muted loop playsinline autoplay preload="metadata" aria-label="Sala de PCs de GamerZone"></video>
  </div>
  <div class="velo"></div>

  <div class="contenedor contenido" data-hero-contenido>
    <h1 class="titulo-display" data-hero-pieza>{resto.length ? <>{inicio},<br />{resto.join(', ')}</> : inicio}</h1>
    <div class="fila">
      <p class="lead" data-hero-pieza>{TEXTOS.portada.texto}</p>
      <div class="acciones" data-hero-pieza>
        <a class="btn" href="#reserva">Reservar sesión</a>
        <a class="btn btn-ghost" href="#precios">Ver precios</a>
      </div>
    </div>

    <!-- Lo esencial de un vistazo -->
    <dl class="barra" data-hero-pieza>
      <div>
        <dt>Hoy</dt>
        <dd class:list={['estado', { pendiente: HORARIO.pendiente }]} data-hero-estado>10:00 – 22:00</dd>
      </div>
      <div>
        <dt>PC gamer</dt>
        <dd><span class:list={{ pendiente: PRECIO_HORA_PC.pendiente }}>{PRECIO_HORA_PC.texto}</span> la hora</dd>
      </div>
      <div>
        <dt>Dónde</dt>
        <dd><a href="#sedes">{SEDES.length} sedes en <span class:list={{ pendiente: NEGOCIO.ciudad.pendiente }}>{NEGOCIO.ciudad.texto}</span></a></dd>
      </div>
      <div>
        <dt>Viernes y sábado</dt>
        <dd>Transnochón</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import { estadoHoy, type DiaHorario } from '../lib/horario'
  const hero = document.querySelector<HTMLElement>('[data-hero]')
  const valor = hero?.querySelector<HTMLElement>('[data-hero-estado]')
  if (hero && valor) {
    const estado = estadoHoy(JSON.parse(hero.dataset.horario || '[]') as DiaHorario[])
    valor.textContent = `${estado.abierto ? 'Abierto' : 'Cerrado'} · ${estado.corto}`
    valor.toggleAttribute('data-abierto', estado.abierto)
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: clip;
  }
  .fondo { position: absolute; inset: 0; }
  .fondo video { width: 100%; height: 100%; object-fit: cover; }
  /* Oscurece solo donde va el texto: la sala se sigue viendo arriba */
  .velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--grafito) 2%, rgb(11 13 16 / 0.82) 34%, rgb(11 13 16 / 0.12) 72%, rgb(11 13 16 / 0.35));
  }

  .contenido {
    position: relative;
    display: grid;
    gap: var(--s-3);
    padding-block: calc(var(--nav-h) + var(--s-5)) var(--s-3);
  }
  .contenido .titulo-display { max-width: 20ch; }
  .fila {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-3) var(--s-5);
  }
  .fila .lead { max-width: 50ch; color: var(--sobre-oscuro); }
  .acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .barra {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--s-2);
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .barra div { display: grid; gap: 0.2rem; padding: var(--s-2) var(--s-2) var(--s-1) 0; }
  .barra div + div { padding-left: var(--s-3); border-left: 1px solid rgb(255 255 255 / 0.1); }
  .barra dt { font-size: var(--t-xs); color: var(--sobre-oscuro-2); }
  .barra dd { font: 600 var(--t-m) / 1.3 var(--f-sans); }
  .barra a { text-decoration: none; }
  .barra a:hover { text-decoration: underline; }

  @media (max-width: 64rem) {
    .barra { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .barra div + div:nth-child(3) { padding-left: 0; border-left: 0; }
    .barra div:nth-child(n + 3) { border-top: 1px solid rgb(255 255 255 / 0.1); }
  }
  @media (max-width: 47.99rem) {
    .contenido .titulo-display { max-width: 7.8ch; }
    .acciones { width: 100%; }
    .acciones .btn { flex: 1; }
    .barra div + div { padding-left: var(--s-2); }
    .barra div + div:nth-child(3) { padding-left: 0; }
    .barra dd { font-size: var(--t-s); }
  }
</style>
