---
import { PLANES, PRECIO_HORA_PC, waLink } from '../data/local'
// Si el plan equivale a horas de PC, se muestra cuánto se ahorra frente a pagar por hora
const pesos = (n: number) => `$${n.toLocaleString('es-CO')}`
const ahorro = (p: (typeof PLANES)[number]) =>
  'horasPc' in p && p.horasPc ? p.horasPc * PRECIO_HORA_PC.valor - p.valor : 0
---

<section class="planes" aria-labelledby="planes-titulo">
  <header class="cabeza">
    <h2 class="display titulo" id="planes-titulo">Planes para el grupo</h2>
    <p class="lead">Para cuando una hora no alcanza.</p>
  </header>
  <ol class="pila">
    {
      PLANES.map((p, i) => (
        <li class={`boleto nivel-${i + 1}`}>
          <div class="cuerpo">
            <span class="label">{`Plan ${String(i + 1).padStart(2, '0')}`}</span>
            <h3 class="display nombre">{p.nombre}</h3>
            <p class="texto">{p.texto}</p>
            <ul class="incluye">
              {p.incluye.map((x) => <li class="label">{x}</li>)}
            </ul>
          </div>
          <div class="talon">
            <dl class="datos">
              <div>
                <dt class="label">Duración</dt>
                <dd class:list={{ pendiente: p.pendiente }}>{p.duracion}</dd>
              </div>
              <div>
                <dt class="label">Personas</dt>
                <dd class:list={{ pendiente: p.pendiente }}>{p.personas}</dd>
              </div>
            </dl>
            <p class:list={['precio', { pendiente: p.pendiente }]}>{p.precio}</p>
            {ahorro(p) > 0 && (
              <p class="ahorro">Ahorras {pesos(ahorro(p))} frente a la tarifa por hora</p>
            )}
            <a class="btn" href={waLink(`Hola, me interesa el plan "${p.nombre}".`)} target="_blank" rel="noopener">Reservar este plan</a>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .planes { padding: var(--s-seccion) var(--gutter); }
  .cabeza { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-4); padding-bottom: var(--s-5); }
  .titulo { max-width: 10ch; font-size: var(--t-display); font-stretch: 58%; }

  /* Boletos que se apilan con sticky: cuerpo a la izquierda, talón perforado a la derecha */
  .pila { display: grid; gap: var(--s-4); }
  .boleto {
    --talon: min(22rem, 34%);
    --muesca: 14px;
    position: sticky;
    top: calc(var(--nav-h) + var(--s-3));
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--talon);
    min-height: 26rem;
    border-radius: var(--radio-media);
    /* Muescas semicirculares arriba y abajo de la línea de corte */
    mask:
      radial-gradient(circle var(--muesca) at calc(100% - var(--talon)) 0, transparent 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle var(--muesca) at calc(100% - var(--talon)) 100%, transparent 98%, #000) bottom / 100% 51% no-repeat;
  }
  .nivel-1 { background: var(--superficie); }
  .nivel-2 { background: var(--superficie-2); top: calc(var(--nav-h) + var(--s-4)); }
  .nivel-3 { background: var(--superficie-3); top: calc(var(--nav-h) + var(--s-5)); }

  .cuerpo { display: grid; align-content: space-between; gap: var(--s-4); padding: var(--s-5); }
  .nombre { font-size: clamp(var(--t-4xl), 7vw, 7.5rem); font-stretch: 55%; }
  .texto { max-width: 36ch; font-size: var(--t-xl); color: var(--texto-secundario); }
  .incluye { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); }
  .incluye li { color: var(--texto); }

  .talon {
    display: grid;
    align-content: space-between;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-4);
    border-left: 2px dashed var(--fondo-activo);
  }
  .datos { display: grid; gap: var(--s-2); }
  .datos div { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: var(--s-1); border-bottom: 1px solid var(--linea); }
  .datos dd { font: 500 var(--t-l) / 1 var(--f-mono); }
  .precio {
    font: 800 clamp(var(--t-4xl), 5vw, 4.5rem) / 1 var(--f-display);
    font-stretch: 62%;
    background: var(--rgb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .talon .btn { width: 100%; }
  .ahorro { margin-top: calc(var(--s-3) * -1); font-size: var(--t-s); color: var(--acento-2); }

  @media (max-width: 47.99rem) {
    .cabeza { flex-direction: column; align-items: flex-start; }
    /* Mobile: el talón va debajo y el corte es horizontal */
    .boleto { grid-template-columns: 1fr; min-height: 0; mask: none; }
    .cuerpo { padding: var(--s-4) var(--s-3); }
    .talon { padding: var(--s-4) var(--s-3); border-left: 0; border-top: 2px dashed var(--fondo-activo); }
  }
</style>
