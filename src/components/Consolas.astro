---
import { Picture } from 'astro:assets'
import { CONSOLAS, PRECIO_HORA_CONSOLA, TEXTOS } from '../data/local'

// Eje de tiempo con distancias reales entre lanzamientos
const desde = Number(CONSOLAS[0].anio)
const hasta = Number(CONSOLAS[CONSOLAS.length - 1].anio)
const pos = (anio: string) => ((Number(anio) - desde) / (hasta - desde)) * 100
---

<section class="consolas" id="consolas" data-consolas>
  <div class="pin" data-consolas-pin>
    <div class="pista" data-consolas-pista>
      <header class="intro">
        <h2 class="titulo">{TEXTOS.consolas.titulo}</h2>
        <p class="lead">
          {TEXTOS.consolas.texto} Desde <span class:list={{ pendiente: PRECIO_HORA_CONSOLA.pendiente }}>{PRECIO_HORA_CONSOLA.texto}</span> la hora.
        </p>
      </header>
      {
        CONSOLAS.map((c, i) => (
          <article class="panel" data-panel={i} data-anio={c.anio}>
            <div class="foto" data-panel-foto>
              <Picture src={c.img} alt={`Control de ${c.nombre}`} formats={['avif', 'webp']} fallbackFormat="webp" widths={[700, 1100, 1600]} sizes="(max-width: 64rem) 86vw, 34vw" />
            </div>
            <div class="info" data-panel-info>
              <h3 class="nombre">{c.nombre}</h3>
              <p class="texto">{c.texto}</p>
              <ul class="ficha">
                <li>Lanzada en {c.anio}</li>
                {c.ficha.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="eje" aria-hidden="true">
      <div class="regla" data-eje>
        {
          CONSOLAS.map((c, i) => (
            <span class="hito" data-hito={i} data-x={pos(c.anio)}>
              <span class="hito-anio">{c.anio}</span>
              <span class="hito-nombre">{c.nombre}</span>
            </span>
          ))
        }
        <span class="marcador" data-marcador></span>
      </div>
    </div>
  </div>
</section>

<style>
  .pin {
    position: relative;
    height: 100svh;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
  }
  .pista {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 0;
    padding: var(--nav-h) max(var(--gutter), (100vw - var(--ancho-max)) / 2) 0;
  }

  /* Cierre de la pista: deja aire después del último panel */
  .pista::after { content: ''; flex: 0 0 1px; }

  .intro {
    flex: 0 0 min(30rem, 34vw);
    display: grid;
    gap: var(--s-3);
  }

  /* Un panel por consola: foto arriba en tarjeta, ficha debajo */
  .panel {
    flex: 0 0 min(34rem, 40vw);
    display: grid;
    gap: var(--s-3);
  }
  .foto {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radio-l);
    background: var(--grafito-2);
  }
  .foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .info { display: grid; gap: 0.6rem; }
  .nombre { font: 800 var(--t-3xl) / 1 var(--f-sans); font-stretch: var(--ancho-titulo); letter-spacing: -0.025em; }
  .texto { max-width: 34ch; font-size: var(--t-l); color: var(--sobre-oscuro-2); }
  .ficha { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; }
  .ficha li {
    padding: 0.35rem 0.8rem;
    border-radius: var(--radio-boton);
    background: var(--grafito-2);
    font: 600 var(--t-xs) / 1.3 var(--f-sans);
  }

  /* Eje 2005 → 2020: las distancias entre hitos son los años reales */
  .eje {
    width: min(100% - 2 * var(--gutter), var(--ancho-max));
    margin-inline: auto;
    padding-block: var(--s-3) var(--s-4);
  }
  .regla { position: relative; height: 3rem; margin-inline: 2.5rem; }
  /* Línea base y una marca por año: 15 intervalos entre 2005 y 2020 */
  .regla::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--linea-oscura);
  }
  .hito {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding-top: 0.9rem;
    transform: translateX(-50%);
    color: var(--sobre-oscuro-2);
    transition: color var(--dur-micro);
  }
  .hito::before { content: ''; position: absolute; top: -4px; width: 1px; height: 9px; background: currentColor; }
  .hito-anio { font: 700 var(--t-xs) / 1 var(--f-sans); }
  .hito-nombre { font: 600 var(--t-s) / 1 var(--f-sans); white-space: nowrap; }
  .hito[data-activo] { color: var(--sobre-oscuro); }
  .hito[data-activo] .hito-anio { color: var(--acento); }
  .marcador {
    position: absolute;
    top: -5px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--acento);
    transform: translateX(-50%);
  }

  /* Tablet, mobile y sin movimiento: carrusel nativo con snap */
  @media (max-width: 64rem) {
    .pin { height: auto; padding-top: var(--s-seccion); }
    .pista {
      align-items: start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding: 0 var(--gutter);
      gap: var(--s-2);
      scrollbar-width: none;
    }
    .pista::-webkit-scrollbar { display: none; }
    .intro { flex-basis: 70vw; align-self: center; scroll-snap-align: start; }
    .panel { flex-basis: 70vw; scroll-snap-align: start; }
    .eje { margin-top: var(--s-3); }
  }
  @media (max-width: 47.99rem) {
    .intro, .panel { flex-basis: 84vw; }
    .regla { margin-inline: 1.5rem; }
    .hito-nombre { display: none; }
  }
  :global(.reduced) .pin { height: auto; padding-top: var(--s-seccion); }
  :global(.reduced) .pista { overflow-x: auto; scroll-snap-type: x mandatory; }
  :global(.reduced) .panel, :global(.reduced) .intro { scroll-snap-align: start; }
</style>
