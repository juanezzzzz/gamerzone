---
import { FAQ, TEXTOS, waLink } from '../data/local'
import Icono from './Icono.astro'
---

<section class="faq claro" aria-labelledby="faq-titulo">
  <div class="contenedor rejilla">
    <div class="pegado">
      <h2 class="titulo" id="faq-titulo">{TEXTOS.faq.titulo}</h2>
      <p class="lead">¿Otra duda? <a href={waLink('Hola, tengo una pregunta.')} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>.</p>
    </div>
    <div class="lista">
      {
        FAQ.map((f) => (
          <details class="item">
            <summary>
              {f.p}
              <Icono nombre="mas" class="signo" />
            </summary>
            <p class:list={{ pendiente: f.pendiente }}>{f.r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq { padding-block: var(--s-seccion); }
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--s-4) var(--s-6);
    align-items: start;
  }
  .pegado { position: sticky; top: calc(var(--nav-h) + var(--s-4)); display: grid; gap: var(--s-2); }
  .pegado a { color: var(--acento-texto); font-weight: 600; }

  .lista { border-top: 1px solid var(--linea-clara); }
  .item { border-bottom: 1px solid var(--linea-clara); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding-block: 1.25rem;
    font: 700 var(--t-l) / 1.3 var(--f-sans);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--acento-texto); }
  summary :global(.signo) { width: 1.25rem; height: 1.25rem; transition: transform 300ms var(--ease-ui); }
  .item[open] summary :global(.signo) { transform: rotate(45deg); }
  .item p { max-width: 60ch; padding-bottom: 1.25rem; color: var(--tinta-2); }

  @media (max-width: 64rem) {
    .rejilla { grid-template-columns: 1fr; }
    .pegado { position: static; }
  }
</style>
