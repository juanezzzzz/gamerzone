---
import { TARIFAS, PLANES, PRECIO_HORA_PC, TEXTOS, pesos, waLink } from '../data/local'
import Icono from './Icono.astro'
// Si el plan equivale a horas de PC, se muestra cuánto se ahorra frente a pagar por hora
const ahorro = (p: (typeof PLANES)[number]) =>
  'horasPc' in p && p.horasPc ? p.horasPc * PRECIO_HORA_PC.valor - p.valor : 0
const iconos = ['monitor', 'control', 'grupo'] as const
---

<section class="precios claro" id="precios">
  <div class="contenedor">
    <header class="cabeza-doble cabeza" data-reveal>
      <h2 class="titulo">{TEXTOS.precios.titulo}</h2>
      <p class="lead">{TEXTOS.precios.texto}</p>
    </header>

    <!-- Una sola carta con tres columnas: se comparan de un vistazo -->
    <ul class="carta" data-carta>
      {
        TARIFAS.map((g, i) => {
          const [principal, ...resto] = g.filas
          return (
            <li class:list={['tarifa', { vip: g.vip }]} data-superficie={g.vip ? 'oscura' : undefined}>
              <h3 class="nombre">
                <Icono nombre={iconos[i]} />
                {g.grupo}
              </h3>
              <p class="principal">
                <span class:list={['monto', { pendiente: principal.pendiente }]}>{principal.precio}</span>
                <span class="unidad">{principal.nombre.toLowerCase()}</span>
              </p>
              {resto.length > 0 && (
                <dl class="resto">
                  {resto.map((f) => (
                    <div>
                      <dt>{f.nombre}</dt>
                      <dd class:list={{ pendiente: f.pendiente }}>{f.precio}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {g.vip && (
                <a class="enlace" href="#vip">
                  Conocer la sala <Icono nombre="flecha" />
                </a>
              )}
            </li>
          )
        })
      }
    </ul>
    <p class="nota dato">{TEXTOS.precios.nota}</p>

    <!-- Planes: tres columnas sobre una línea, sin más tarjetas -->
    <div class="planes">
      <h3 class="subtitulo" data-reveal>{TEXTOS.precios.planes}</h3>
      <ol class="lista-planes">
        {
          PLANES.map((p) => (
            <li class="plan" data-reveal>
              <div class="plan-cabeza">
                <h4 class="plan-nombre">{p.nombre}</h4>
                <p class:list={['plan-precio', { pendiente: p.pendiente }]}>{p.precio}</p>
              </div>
              {ahorro(p) > 0 && <p class="ahorro">Ahorras {pesos(ahorro(p))} frente a la tarifa por hora</p>}
              <p class="plan-texto">{p.texto}</p>
              <ul class="incluye">
                <li><Icono nombre="reloj" /><span class:list={{ pendiente: p.pendiente }}>{p.duracion}</span></li>
                <li><Icono nombre="grupo" /><span class:list={{ pendiente: p.pendiente }}>{p.personas === '1' ? '1 persona' : /^\d+$/.test(p.personas) ? `${p.personas} personas` : p.personas}</span></li>
                {p.incluye.map((x) => (
                  <li>
                    <Icono nombre="check" />
                    {x}
                  </li>
                ))}
              </ul>
              <a class="enlace plan-enlace" href={waLink(`Hola, me interesa el plan "${p.nombre}".`)} target="_blank" rel="noopener">
                Reservar este plan <Icono nombre="flecha" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .precios { padding-block: var(--s-seccion); }
  .cabeza { margin-bottom: var(--s-5); }

  .carta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border-radius: var(--radio-l);
    background: var(--blanco);
    box-shadow: var(--sombra-tarjeta);
  }
  .tarifa {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
  }
  .tarifa + .tarifa:not(.vip) { border-left: 1px solid var(--linea-clara); }
  .nombre {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font: 700 var(--t-l) / 1.2 var(--f-sans);
    white-space: nowrap;
  }
  .principal { display: grid; gap: 0.15rem; }
  .monto {
    font: 800 var(--t-precio) / 1 var(--f-sans);
    font-stretch: var(--ancho-titulo);
    letter-spacing: -0.03em;
  }
  .unidad { font-weight: 500; color: var(--tinta-2); }
  .resto { display: grid; }
  .resto div {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    padding-block: 0.75rem;
    border-top: 1px solid var(--linea-clara);
  }
  .resto dt { color: var(--tinta-2); }
  .resto dd { font-weight: 700; white-space: nowrap; }

  /* La sala VIP es la única tarifa oscura y la única con dorado */
  .tarifa.vip { background: var(--vip-noche); color: var(--sobre-oscuro); }
  .tarifa.vip .nombre :global(.icono) { color: var(--vip); }
  .tarifa.vip .monto { color: var(--vip); }
  .tarifa.vip .unidad { color: var(--sobre-oscuro-2); }
  .tarifa.vip .enlace { margin-top: auto; color: var(--vip); }

  .nota { margin-top: var(--s-3); }

  .planes { margin-top: var(--s-6); }
  .lista-planes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-3);
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding-top: var(--s-3);
    border-top: 2px solid var(--tinta);
  }
  .plan-cabeza { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-2); }
  .plan-nombre { font: 800 var(--t-l) / 1.2 var(--f-sans); font-stretch: 106%; letter-spacing: -0.01em; }
  .plan-precio { font: 800 var(--t-xl) / 1 var(--f-sans); font-stretch: var(--ancho-titulo); letter-spacing: -0.02em; white-space: nowrap; }
  .ahorro { font: 700 var(--t-xs) / 1.3 var(--f-sans); color: var(--acento-texto); }
  .plan-texto { color: var(--tinta-2); }
  .incluye { display: grid; gap: 0.4rem; margin-block: var(--s-1) var(--s-2); font-size: var(--t-s); }
  .incluye li { display: flex; align-items: center; gap: 0.5rem; }
  .incluye :global(.icono) { width: 1.1rem; height: 1.1rem; color: var(--acento-texto); }
  .plan-enlace { margin-top: auto; }

  @media (max-width: 64rem) {
    /* Tablet: PC y consola lado a lado; la VIP a todo el ancho */
    .carta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tarifa.vip { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; }
    .tarifa.vip .nombre { flex-basis: 100%; }
    .tarifa.vip .enlace { margin-top: 0; }
    .lista-planes { gap: var(--s-3); }
    .plan-cabeza { flex-direction: column; gap: 0.25rem; }
  }
  @media (max-width: 47.99rem) {
    .carta { grid-template-columns: 1fr; }
    .tarifa { padding: var(--s-3); }
    .tarifa + .tarifa:not(.vip) { border-left: 0; border-top: 1px solid var(--linea-clara); }
    .tarifa.vip { flex-direction: column; flex-wrap: nowrap; align-items: stretch; justify-content: flex-start; }
    .tarifa.vip .nombre { flex-basis: auto; }
    .lista-planes { grid-template-columns: 1fr; gap: var(--s-4); }
    .plan-cabeza { flex-direction: row; gap: var(--s-2); }
  }
</style>
