---
import { Picture } from 'astro:assets'
import { SPECS_PC, MEDIA_PC, PRECIO_HORA_PC } from '../data/local'
---

<section class="pcs" id="pcs" data-pcs>
  <div class="texto">
    <header class="cabeza">
      <p class="label">PCs gamer</p>
      <h2 class="display titulo" data-reveal>Rendimiento sin compromiso.</h2>
      <p class="lead">
        Llegas, te sientas y juegas. Desde <span class:list={{ pendiente: PRECIO_HORA_PC.pendiente }}>{PRECIO_HORA_PC.texto}</span> la hora.
      </p>
    </header>
    <!-- Las cuatro specs a la vista; al elegir una, la media de la derecha la muestra -->
    <ul class="specs" aria-label="Qué tienen los PCs">
      {
        SPECS_PC.map((s, i) => (
          <li>
            <button class="spec" type="button" data-spec={s.media} data-activa={i === 0 ? '' : undefined} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="label">{s.label}</span>
              <span class:list={['valor', { pendiente: s.pendiente }]}>{s.valor}</span>
              <span class="nota">{s.nota}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="media" aria-hidden="true">
    <div class="marco">
      {
        Object.entries(MEDIA_PC).map(([clave, m], i) => (
          <div class="capa" data-capa={clave} data-activa={i === 0 ? '' : undefined}>
            {m.tipo === 'img' ? (
              <Picture src={m.src} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1000, 1400]} sizes="(max-width: 47.99rem) 100vw, 55vw" />
            ) : (
              <video src={m.src} poster={m.poster} muted loop playsinline preload="none" />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Split asimétrico: specs a la vista a la izquierda, media que cambia según la spec elegida */
  .pcs {
    display: grid;
    grid-template-columns: 45fr 55fr;
    gap: var(--gutter);
    align-items: center;
    padding: var(--s-seccion) var(--gutter);
    border-top: 1px solid var(--linea);
  }
  .texto { display: grid; gap: var(--s-5); }
  .cabeza { display: grid; gap: var(--s-3); }
  .titulo { font-size: var(--t-display); font-stretch: 62%; }

  .specs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-1); }
  .spec {
    width: 100%;
    height: 100%;
    display: grid;
    align-content: start;
    gap: var(--s-1);
    padding: var(--s-3);
    border: 1px solid var(--linea);
    border-radius: var(--radio-media);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color var(--dur-micro), background-color var(--dur-micro);
  }
  .spec:hover { border-color: var(--acento-claro); }
  .spec[data-activa] { border-color: var(--acento); background: var(--superficie); box-shadow: 0 0 24px -12px var(--acento); }
  .valor {
    font: 800 var(--t-3xl) / 1 var(--f-display);
    font-stretch: 62%;
    text-transform: uppercase;
  }
  .nota { font-size: var(--t-s); color: var(--texto-secundario); }

  .marco {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - var(--nav-h) - var(--s-5));
    width: 100%;
    overflow: hidden;
    border-radius: var(--radio-media);
    background: var(--superficie);
  }
  .capa {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 700ms var(--ease-ui), transform 1200ms var(--ease-ui);
  }
  .capa[data-activa] { opacity: 1; transform: scale(1); }
  .capa :global(img), .capa video { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 64rem) {
    /* Título, media y specs en ese orden */
    .pcs { grid-template-columns: 1fr; }
    .texto { display: contents; }
    .cabeza { order: -2; }
    .media { order: -1; }
    .marco { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 47.99rem) {
    .specs { grid-template-columns: 1fr 1fr; }
    .spec { padding: var(--s-2); }
    .valor { font-size: var(--t-2xl); }
  }
</style>
