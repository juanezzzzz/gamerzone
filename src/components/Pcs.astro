---
import { Picture } from 'astro:assets'
import { SPECS_PC, MEDIA_PC, PRECIO_HORA_PC, TEXTOS, waLink } from '../data/local'
---

<section class="pcs" id="pcs" data-pcs>
  <div class="contenedor">
    <header class="cabeza" data-reveal>
      <h2 class="titulo-xl">{TEXTOS.pcs.titulo}</h2>
      <p class="lead">
        {TEXTOS.pcs.texto} Desde <span class:list={{ pendiente: PRECIO_HORA_PC.pendiente }}>{PRECIO_HORA_PC.texto}</span> la hora.
      </p>
    </header>

    <div class="cuerpo">
      <!-- La media queda fija mientras pasan las specs; cada una enciende su capa -->
      <div class="media" aria-hidden="true">
        <div class="marco">
          {
            Object.entries(MEDIA_PC).map(([clave, m], i) => (
              <div class="capa" data-capa={clave} data-activa={i === 0 ? '' : undefined}>
                {m.tipo === 'img' ? (
                  <Picture src={m.src} alt="" formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1000, 1400]} sizes="(max-width: 47.99rem) 100vw, 50vw" />
                ) : (
                  <video src={m.src} poster={m.poster} muted loop playsinline preload="none" />
                )}
              </div>
            ))
          }
        </div>
      </div>

      <ol class="specs" aria-label="Qué tienen los PCs">
        {
          SPECS_PC.map((s, i) => (
            <li class="spec" aria-label={s.label} data-spec={s.media} data-activa={i === 0 ? '' : undefined}>
              <p class:list={['spec-valor', { pendiente: s.pendiente }]}>{s.valor}</p>
              <p class="spec-nota">{s.nota}</p>
            </li>
          ))
        }
        <li class="spec-cierre">
          <a class="btn" href={waLink('Hola, quiero reservar un PC en GamerZone.')} target="_blank" rel="noopener">Reservar un PC</a>
        </li>
      </ol>
    </div>
  </div>
</section>

<script>
  // La spec que cruza el centro de la pantalla enciende su media
  const specs = [...document.querySelectorAll<HTMLElement>('[data-spec]')]
  const capas = [...document.querySelectorAll<HTMLElement>('[data-capa]')]
  const reducido = document.documentElement.classList.contains('reduced')
  const activar = (clave: string) => {
    specs.forEach((s) => s.toggleAttribute('data-activa', s.dataset.spec === clave))
    capas.forEach((c) => {
      const activa = c.dataset.capa === clave
      c.toggleAttribute('data-activa', activa)
      const v = c.querySelector('video')
      if (v && activa && !reducido) v.play().catch(() => {})
      else if (v) v.pause()
    })
  }
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && activar((e.target as HTMLElement).dataset.spec!)),
    { rootMargin: '-45% 0px -45% 0px' }
  )
  specs.forEach((s) => io.observe(s))
</script>

<style>
  .pcs { padding-block: var(--s-seccion); }
  .cabeza { display: grid; gap: var(--s-2); max-width: 46rem; }

  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-6);
    margin-top: var(--s-5);
  }
  .media { position: relative; }
  .marco {
    position: sticky;
    top: calc(var(--nav-h) + var(--s-4));
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - var(--nav-h) - var(--s-6));
    width: 100%;
    overflow: hidden;
    border-radius: var(--radio-l);
    background: var(--grafito-2);
  }
  .capa {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 700ms var(--ease-ui), transform 1200ms var(--ease-ui);
  }
  .capa[data-activa] { opacity: 1; transform: none; }
  .capa :global(img), .capa video { width: 100%; height: 100%; object-fit: cover; }

  .specs { display: grid; }
  .spec {
    display: grid;
    align-content: center;
    gap: 0.5rem;
    min-height: 52svh;
    opacity: 0.3;
    transition: opacity 500ms var(--ease-ui);
  }
  .spec[data-activa] { opacity: 1; }
  .spec-valor {
    max-width: 14ch;
    font: 800 var(--t-3xl) / 1.02 var(--f-sans);
    font-stretch: var(--ancho-titulo);
    letter-spacing: -0.03em;
  }
  .spec-nota { max-width: 32ch; font-size: var(--t-l); color: var(--sobre-oscuro-2); }
  .spec-cierre { padding-block: var(--s-4) var(--s-5); }

  @media (max-width: 47.99rem) {
    /* Mobile: la media queda arriba, fija, y las specs pasan debajo */
    .cuerpo { grid-template-columns: 1fr; gap: 0; }
    .media { position: sticky; top: var(--nav-h); z-index: 1; padding-block: var(--s-2); background: var(--grafito); }
    .marco { position: relative; top: 0; aspect-ratio: 16 / 10; }
    .spec { min-height: 42svh; }
    .spec-cierre .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .capa, .spec { transition: none; }
  }
</style>
