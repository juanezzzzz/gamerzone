---
import { NEGOCIO } from '../data/local'
import { url } from '../lib/url'
---

<!-- Intro: el logo 3D se arma una sola vez por visita, encima del hero. No ocupa scroll y cualquier
     gesto la salta. Sin JS, con reduced motion o de vuelta en la misma visita no aparece. -->
<div class="intro" data-intro aria-hidden="true">
  <gamerzone-logo autoplay no-sound src={url('/logo/gamerzone-logo.glb')} poster={url('/logo/gamerzone-poster.webp')}>
    <p data-from="0.5" data-to="1.01">Bienvenido a {NEGOCIO.nombre}</p>
  </gamerzone-logo>
</div>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]')
  const root = document.documentElement
  const avisar = () => {
    root.classList.remove('con-intro')
    root.dataset.introFin = ''
    document.dispatchEvent(new Event('gz:intro-fin'))
  }

  if (intro && root.classList.contains('con-intro')) {
    import('../scripts/gz-logo.js')
    let cerrada = false
    const cerrar = () => {
      if (cerrada) return
      cerrada = true
      gestos.forEach((g) => window.removeEventListener(g, cerrar))
      intro.classList.add('saliendo')
      // El hero entra mientras la intro se desvanece
      avisar()
      setTimeout(() => intro.remove(), 700)
    }
    const gestos = ['wheel', 'touchstart', 'keydown', 'pointerdown']
    gestos.forEach((g) => window.addEventListener(g, cerrar, { passive: true }))
    setTimeout(cerrar, 3400)
    try {
      sessionStorage.setItem('gz-intro', '1')
    } catch {}
  } else {
    intro?.remove()
    avisar()
  }
</script>

<style>
  .intro { display: none; }
  :global(.con-intro) .intro,
  .intro:global(.saliendo) {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: block;
    background: var(--grafito);
    transition: opacity 600ms var(--ease-ui);
  }
  .intro:global(.saliendo) { opacity: 0; pointer-events: none; }
  /* El alto se reserva aquí: el componente mide su propio scroll con esta variable */
  gamerzone-logo {
    --gz-scroll: 100svh;
    /* El componente lee estos nombres: se mapean a los tokens del sitio */
    --texto: var(--sobre-oscuro);
    --texto-secundario: var(--sobre-oscuro-2);
    --noche: var(--grafito);
    --f-display: var(--f-sans);
    --f-mono: var(--f-sans);
    --rgb: var(--acento);
    display: block;
    height: 100svh;
  }
  /* Los subtítulos son datos para el componente; no se muestran antes de que cargue */
  gamerzone-logo > p { display: none; }
</style>
