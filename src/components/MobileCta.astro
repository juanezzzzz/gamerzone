<div class="mobile-cta" data-mobile-cta>
  <a class="btn" href="#reserva">Reservar sesión</a>
</div>

<style>
  .mobile-cta { display: none; }

  @media (max-width: 47.99rem) {
    .mobile-cta {
      position: fixed;
      inset: auto 0 0;
      z-index: 40;
      display: block;
      padding: var(--s-2) var(--gutter) calc(var(--s-2) + env(safe-area-inset-bottom, 0px));
      /* Opaca: translúcida se vuelve gris sobre las secciones claras */
      background: var(--grafito);
      transition: transform 400ms var(--ease-ui), opacity 400ms var(--ease-ui);
    }
    .mobile-cta .btn { width: 100%; min-height: 3.25rem; }
    /* Se esconde en el hero, la VIP y el CTA final, donde ya hay botón */
    .mobile-cta.oculto { transform: translateY(110%); opacity: 0; }
  }
</style>
