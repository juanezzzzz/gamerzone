---
import { waLink } from '../data/local'
---

<div class="mobile-cta" data-mobile-cta>
  <a class="btn" href={waLink()} target="_blank" rel="noopener">Reservar sesión</a>
</div>

<style>
  .mobile-cta { display: none; }

  @media (max-width: 47.99rem) {
    .mobile-cta {
      position: fixed;
      inset: auto 0 0;
      z-index: 40;
      display: block;
      padding: var(--s-2) var(--gutter) calc(var(--s-2) + env(safe-area-inset-bottom, 0px));
      background: linear-gradient(to top, var(--noche) 55%, transparent);
      transition: transform 400ms var(--ease-ui), opacity 400ms;
    }
    .mobile-cta .btn { width: 100%; }
    /* Se esconde en el hero, la VIP y el CTA final, donde ya hay botón */
    .mobile-cta.oculto { transform: translateY(110%); opacity: 0; }
  }
</style>
