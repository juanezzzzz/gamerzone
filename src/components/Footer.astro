---
import { Image } from 'astro:assets'
import { NEGOCIO, REVISION, SEDES } from '../data/local'
import emblema from '../assets/brand/gamerzone-logo.png'
const anio = new Date().getFullYear()
---

<footer class="footer">
  <div class="firma">
    <Image src={emblema} alt={`Logo de ${NEGOCIO.nombre} ${NEGOCIO.lema}`} width={96} densities={[1, 2]} format="webp" class="emblema" />
    <p class="marca">{NEGOCIO.nombre}</p>
    <p class="lema">{NEGOCIO.lema}. Sala de videojuegos con PCs gamer, Xbox y sala VIP, en {SEDES.length} sedes.</p>
  </div>
  <nav class="links" aria-label="Pie de página">
    <a href="#precios">Precios</a>
    <a href="#sedes">Sedes</a>
    <a href="#equipos">Equipos</a>
    <a href="#vip">Sala VIP</a>
    <a href="#juegos">Juegos</a>
    <a href="#reserva">Reservar</a>
  </nav>
  <p class="legal">
    © {anio} {NEGOCIO.nombre}. Fotos de referencia: <a href="https://pixabay.com" target="_blank" rel="noopener">Pixabay</a>.
    {REVISION && ' Sitio en revisión: los datos subrayados están por confirmar.'}
  </p>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-4);
    width: min(100% - 2 * var(--gutter), var(--ancho-max));
    margin-inline: auto;
    padding: var(--s-5) 0 var(--s-4);
    border-top: 1px solid var(--linea-oscura);
  }
  .marca { font: 800 var(--t-xl) / 1 var(--f-sans); font-stretch: var(--ancho-titulo); letter-spacing: -0.01em; }
  .firma { display: grid; gap: var(--s-1); justify-items: start; }
  .firma :global(.emblema) { width: 4rem; height: 4rem; margin-bottom: var(--s-1); }
  .lema { max-width: 44ch; font-size: var(--t-s); color: var(--sobre-oscuro-2); }
  .links { display: flex; flex-wrap: wrap; gap: var(--s-3); font-size: var(--t-s); }
  .links a { color: var(--sobre-oscuro-2); text-decoration: none; }
  .links a:hover { color: var(--sobre-oscuro); }
  .legal { grid-column: 1 / -1; font-size: var(--t-xs); color: var(--sobre-oscuro-2); }

  @media (max-width: 47.99rem) {
    .footer { grid-template-columns: 1fr; padding-bottom: calc(var(--s-6) + var(--s-4)); }
  }
</style>
