---
import { Image } from 'astro:assets'
import { NEGOCIO, SEDES } from '../data/local'
import emblema from '../assets/brand/gamerzone-logo.png'
// Mismo orden que la página
const links = [
  ['#precios', 'Precios'],
  ['#sedes', 'Sedes'],
  ['#equipos', 'Equipos'],
  ['#vip', 'Sala VIP'],
  ['#juegos', 'Juegos'],
]
---

<header class="nav" data-nav>
  <div class="barra">
    <a class="logo" href="#inicio" aria-label={`${NEGOCIO.nombre}, ir al inicio`}>
      <Image src={emblema} alt="" width={32} densities={[1, 2]} format="webp" class="emblema" />
      <span>{NEGOCIO.nombre}</span>
    </a>
    <nav class="links" aria-label="Secciones">
      {links.map(([href, texto]) => <a href={href}>{texto}</a>)}
    </nav>
    <div class="fin">
      <a class="btn reservar" href="#reserva">Reservar</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú" data-menu-btn>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Menú de tablet y móvil: pantalla completa, links grandes cerca del pulgar -->
<div class="menu" id="menu" data-menu aria-hidden="true">
  <nav aria-label="Menú">
    <ol class="menu-links">
      {
        links.map(([href, texto]) => (
          <li>
            <a href={href} data-menu-link tabindex="-1">{texto}</a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu-pie">
    <a class="btn" href="#reserva" data-menu-link tabindex="-1">Reservar sesión</a>
    <p class="dato">Sala de videojuegos · {SEDES.length} sedes</p>
  </div>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')
  const menu = document.querySelector<HTMLElement>('[data-menu]')
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]')]
  const abrir = (abierto: boolean) => {
    if (!btn || !menu) return
    document.documentElement.classList.toggle('menu-abierto', abierto)
    btn.setAttribute('aria-expanded', String(abierto))
    btn.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú')
    menu.setAttribute('aria-hidden', String(!abierto))
    enlaces.forEach((a) => (a.tabIndex = abierto ? 0 : -1))
  }
  btn?.addEventListener('click', () => abrir(btn.getAttribute('aria-expanded') !== 'true'))
  enlaces.forEach((a) => a.addEventListener('click', () => abrir(false)))
  document.addEventListener('keydown', (e) => e.key === 'Escape' && abrir(false))
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
  }
  /* Dos capas de fondo: la oscura y la clara. Pasar de una a otra solo anima opacidad */
  .nav::before, .nav::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    transition: opacity 400ms var(--ease-ui);
  }
  .nav::before { background: rgb(11 13 16 / 0.92); box-shadow: 0 1px 0 rgb(255 255 255 / 0.06); }
  .nav::after { background: rgb(244 245 247 / 0.94); box-shadow: 0 1px 0 var(--linea-clara); }
  /* Pasada la apertura, la barra se vuelve translúcida para que el contenido no compita con ella */
  .nav:global(.solida)::before { opacity: 1; }
  /* Sobre las secciones claras la barra también es clara */
  .nav:global(.solida.sobre-claro)::before { opacity: 0; }
  .nav:global(.solida.sobre-claro)::after { opacity: 1; }
  .nav:global(.sobre-claro) { color: var(--tinta); }
  .nav:global(.sobre-claro) .links a { color: var(--tinta-2); }
  .nav:global(.sobre-claro) .links a:hover, .nav:global(.sobre-claro) .links a[aria-current] { color: var(--tinta); }
  .nav:global(.sobre-claro) .menu-btn { color: var(--tinta); }
  :global(.menu-abierto) .nav { color: var(--sobre-oscuro); }
  :global(.menu-abierto) .nav::before, :global(.menu-abierto) .nav::after { opacity: 0; }
  :global(.menu-abierto) .nav .menu-btn { color: var(--sobre-oscuro); }

  .barra {
    height: 100%;
    width: min(100% - 2 * var(--gutter), var(--ancho-max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-3);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 800 var(--t-m) / 1 var(--f-sans);
    font-stretch: var(--ancho-titulo);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .logo :global(.emblema) { width: 2rem; height: 2rem; }
  .links { display: flex; gap: var(--s-4); }
  .links a {
    font-size: var(--t-s);
    text-decoration: none;
    color: var(--sobre-oscuro-2);
  }
  .links a:hover, .links a[aria-current] { color: var(--sobre-oscuro); }
  .fin { display: flex; justify-content: flex-end; align-items: center; gap: var(--s-2); }
  .reservar { min-height: 2.25rem; padding: 0 1.1rem; font-size: var(--t-s); }

  .menu-btn {
    display: none;
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sobre-oscuro);
    cursor: pointer;
  }
  .menu-btn span {
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 500ms var(--ease-ui);
  }
  .menu-btn span:first-child { transform: translateY(-4px); }
  .menu-btn span:last-child { transform: translateY(4px); }
  :global(.menu-abierto) .menu-btn span:first-child { transform: rotate(45deg); }
  :global(.menu-abierto) .menu-btn span:last-child { transform: rotate(-45deg); }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: calc(var(--nav-h) + var(--s-4)) var(--gutter) var(--s-5);
    background: var(--grafito);
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms var(--ease-ui);
  }
  :global(.menu-abierto) .menu { opacity: 1; pointer-events: auto; }
  :global(.menu-abierto) body { overflow: hidden; }

  .menu > nav { display: grid; align-content: end; }
  .menu-links { display: grid; gap: 0.25rem; }
  .menu-links a {
    display: block;
    padding-block: 0.15rem;
    font: 800 clamp(2.25rem, 10vw, 3.5rem) / 1.1 var(--f-sans);
    font-stretch: var(--ancho-titulo);
    letter-spacing: -0.02em;
    text-decoration: none;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 500ms var(--ease-ui), transform 500ms var(--ease-ui);
  }
  .menu-links a:hover, .menu-links a:focus-visible { color: var(--acento); }
  :global(.menu-abierto) .menu-links a { opacity: 1; transform: none; }
  /* Escalonado de entrada: cada link un poco después que el anterior */
  :global(.menu-abierto) .menu-links li:nth-child(2) a { transition-delay: 40ms; }
  :global(.menu-abierto) .menu-links li:nth-child(3) a { transition-delay: 80ms; }
  :global(.menu-abierto) .menu-links li:nth-child(4) a { transition-delay: 120ms; }
  :global(.menu-abierto) .menu-links li:nth-child(5) a { transition-delay: 160ms; }
  :global(.menu-abierto) .menu-links li:nth-child(6) a { transition-delay: 200ms; }
  .menu-pie { display: grid; gap: var(--s-2); padding-top: var(--s-4); margin-top: var(--s-4); border-top: 1px solid var(--linea-oscura); }
  .menu-pie .btn { width: 100%; min-height: 3.25rem; }

  @media (max-width: 64rem) {
    .barra { grid-template-columns: 1fr auto; }
    .links { display: none; }
    .menu-btn { display: block; }
  }
  @media (min-width: 64.0625rem) {
    .menu { display: none; }
  }
  @media (max-width: 47.99rem) {
    .reservar { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu, .menu-links a { transition: none; }
  }
</style>
