---
import { Image } from 'astro:assets'
import { NEGOCIO, SEDES, waLink } from '../data/local'
import emblema from '../assets/brand/gamerzone-logo.png'
// Mismo orden que la página
const links = [
  ['#tarifas', 'Tarifas'],
  ['#sedes', 'Sedes'],
  ['#pcs', 'PCs'],
  ['#consolas', 'Consolas'],
  ['#vip', 'Sala VIP'],
  ['#juegos', 'Juegos'],
]
---

<header class="nav" data-nav>
  <a class="logo" href="#inicio" aria-label={`${NEGOCIO.nombre}, ir al inicio`}>
    <Image src={emblema} alt="" width={40} densities={[1, 2]} format="webp" class="emblema" />
    <span>{NEGOCIO.nombre}</span>
  </a>
  <nav class="links" aria-label="Secciones">
    {links.map(([href, texto]) => <a href={href}>{texto}</a>)}
  </nav>
  <div class="fin">
    <a class="btn reservar" href={waLink()} target="_blank" rel="noopener">Reservar</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú" data-menu-btn>
      <span></span><span></span>
    </button>
  </div>
</header>

<!-- Menú de tablet y móvil: pantalla completa, links grandes -->
<div class="menu" id="menu" data-menu aria-hidden="true">
  <nav aria-label="Menú">
    <ol class="menu-links">
      {
        links.map(([href, texto]) => (
          <li>
            <a href={href} data-menu-link tabindex="-1">
              <span>{texto}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu-pie">
    <a class="btn" href={waLink()} target="_blank" rel="noopener" data-menu-link tabindex="-1">Reservar sesión</a>
    <p class="label">Sala de videojuegos · {SEDES.length} sedes</p>
  </div>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')
  const menu = document.querySelector<HTMLElement>('[data-menu]')
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]')]
  const abrir = (abierto: boolean) => {
    if (!btn || !menu) return
    document.documentElement.classList.toggle('menu-abierto', abierto)
    btn.setAttribute('aria-expanded', String(abierto))
    btn.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú')
    menu.setAttribute('aria-hidden', String(!abierto))
    enlaces.forEach((a) => (a.tabIndex = abierto ? 0 : -1))
  }
  btn?.addEventListener('click', () => abrir(btn.getAttribute('aria-expanded') !== 'true'))
  enlaces.forEach((a) => a.addEventListener('click', () => abrir(false)))
  document.addEventListener('keydown', (e) => e.key === 'Escape' && abrir(false))
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-3);
    padding-inline: var(--gutter);
    background: linear-gradient(to bottom, rgb(5 6 13 / 0.85), transparent);
    transition: background-color 300ms, box-shadow 300ms, transform 600ms var(--ease-ui);
  }
  /* Pasado el hero, la barra se vuelve sólida para que el contenido no pase por debajo del logo */
  .nav:global(.solida) { background: var(--fondo-activo); box-shadow: 0 1px 0 var(--linea); }
  :global(.menu-abierto) .nav { transform: none; background: transparent; box-shadow: none; }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font: 800 var(--t-l) / 1 var(--f-display);
    font-stretch: 62%;
    text-transform: uppercase;
    text-decoration: none;
  }
  .logo :global(.emblema) { width: 2.5rem; height: 2.5rem; filter: drop-shadow(0 0 10px rgb(47 224 255 / 0.35)); }
  .links { display: flex; gap: var(--s-4); }
  .links a {
    position: relative;
    font-size: var(--t-s);
    text-decoration: none;
    color: var(--texto-secundario);
    transition: color var(--dur-micro);
  }
  /* Subrayado RGB que crece desde la izquierda */
  .links a::after {
    content: '';
    position: absolute;
    inset: auto 0 -6px;
    height: 2px;
    background: var(--rgb);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease-ui);
  }
  .links a:hover { color: var(--texto); }
  .links a:hover::after { transform: scaleX(1); }
  .fin { display: flex; justify-content: flex-end; align-items: center; gap: var(--s-3); }

  .reservar { min-height: 2.5rem; padding: 0 var(--s-3); font-size: var(--t-s); }

  .menu-btn {
    display: none;
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--texto);
    cursor: pointer;
  }
  .menu-btn span {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    height: 2px;
    background: currentColor;
    transition: transform 500ms var(--ease-ui);
  }
  .menu-btn span:first-child { transform: translateY(-4px); }
  .menu-btn span:last-child { transform: translateY(4px); }
  :global(.menu-abierto) .menu-btn span:first-child { transform: rotate(45deg); }
  :global(.menu-abierto) .menu-btn span:last-child { transform: rotate(-45deg); }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: calc(var(--nav-h) + var(--s-4)) var(--gutter) var(--s-5);
    background:
      radial-gradient(ellipse 60% 40% at 90% 15%, var(--halo-magenta), transparent 70%),
      radial-gradient(ellipse 60% 40% at 0% 90%, var(--halo-cian), transparent 70%),
      var(--noche);
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
    transition: clip-path 700ms cubic-bezier(0.7, 0, 0.2, 1);
  }
  :global(.menu-abierto) .menu { clip-path: inset(0 0 0 0); pointer-events: auto; }
  :global(.menu-abierto) body { overflow: hidden; }

  /* Los links se apoyan abajo, cerca del pulgar */
  .menu > nav { display: grid; align-content: end; }
  .menu-links { display: grid; gap: 0.2rem; }
  .menu-links li { overflow: hidden; }
  .menu-links a {
    display: block;
    font: 900 clamp(2.75rem, 12vw, 5.5rem) / 1 var(--f-display);
    font-stretch: 58%;
    text-transform: uppercase;
    text-decoration: none;
    transform: translateY(105%);
    transition: transform 700ms var(--ease-ui), color var(--dur-micro);
  }
  .menu-links a:hover, .menu-links a:focus-visible { color: var(--acento); }
  :global(.menu-abierto) .menu-links a { transform: none; }
  /* Escalonado de entrada: cada link un poco después que el anterior */
  :global(.menu-abierto) .menu-links li:nth-child(2) a { transition-delay: 60ms; }
  :global(.menu-abierto) .menu-links li:nth-child(3) a { transition-delay: 120ms; }
  :global(.menu-abierto) .menu-links li:nth-child(4) a { transition-delay: 180ms; }
  :global(.menu-abierto) .menu-links li:nth-child(5) a { transition-delay: 240ms; }
  :global(.menu-abierto) .menu-links li:nth-child(6) a { transition-delay: 300ms; }
  .menu-pie { display: grid; gap: var(--s-3); padding-top: var(--s-5); border-top: 1px solid var(--linea); margin-top: var(--s-5); }
  .menu-pie .btn { width: 100%; }

  @media (max-width: 64rem) {
    .nav { grid-template-columns: 1fr auto; }
    .links { display: none; }
    .menu-btn { display: block; }
  }
  @media (min-width: 64.0625rem) {
    .menu { display: none; }
  }
  @media (max-width: 47.99rem) {
    .reservar { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu, .menu-links a { transition: none; }
  }
</style>
