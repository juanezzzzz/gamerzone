---
import { Picture } from 'astro:assets'
import { COMODIDADES, COMODIDADES_FOTO, TEXTOS } from '../data/local'
import Icono from './Icono.astro'
// El panel elige el ícono por nombre; si no existe, va un check
const iconos = ['clima', 'servicio', 'silla', 'tienda', 'pisos', 'noche', 'control', 'monitor', 'grupo', 'pago'] as const
type NombreIcono = (typeof iconos)[number]
const icono = (n: string): NombreIcono | 'check' => ((iconos as readonly string[]).includes(n) ? (n as NombreIcono) : 'check')
---

<!-- Pausa entre dos bloques de información: una foto a sangre con todo lo que hace cómodo el lugar -->
<section class="comodidades" id="comodidades" data-comodidades>
  <div class="foto" data-comodidades-foto>
    <Picture src={COMODIDADES_FOTO} alt={TEXTOS.comodidades.fotoTitulo} formats={['avif', 'webp']} fallbackFormat="webp" widths={[800, 1400, 2000]} sizes="100vw" />
  </div>
  <div class="velo"></div>

  <div class="contenedor contenido">
    <header class="cabeza-doble" data-reveal>
      <h2 class="titulo-xl">{TEXTOS.comodidades.titulo}</h2>
      <p class="lead">{TEXTOS.comodidades.texto}</p>
    </header>

    <ul class="lista">
      <li class="item" data-reveal>
        <Icono nombre="pisos" />
        <h3 class="item-titulo">{TEXTOS.comodidades.fotoTitulo}</h3>
        <p class="item-texto">{TEXTOS.comodidades.fotoTexto}</p>
      </li>
      {
        COMODIDADES.map((c) => (
          <li class="item" data-reveal>
            <Icono nombre={icono(c.icono)} />
            <h3 class="item-titulo">{c.titulo}</h3>
            <p class:list={['item-texto', { pendiente: c.pendiente }]}>{c.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .comodidades {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: clip;
  }
  .foto { position: absolute; inset: -8% 0; }
  .foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--grafito) 8%, rgb(11 13 16 / 0.78) 50%, rgb(11 13 16 / 0.2));
  }

  .contenido {
    position: relative;
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-seccion) var(--s-5);
  }
  .contenido .lead { color: var(--sobre-oscuro); }

  .lista {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s-3);
  }
  .item {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding-top: var(--s-2);
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }
  .item :global(.icono) { color: var(--acento); margin-bottom: 0.4rem; }
  .item-titulo { font: 700 var(--t-xl) / 1.15 var(--f-sans); font-stretch: 106%; }
  .item-texto { font-size: var(--t-s); line-height: 1.45; color: var(--sobre-oscuro-2); }

  @media (max-width: 64rem) {
    .lista { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Mobile: una comodidad por fila, ícono a la izquierda */
  @media (max-width: 47.99rem) {
    .lista { grid-template-columns: 1fr; gap: var(--s-2); }
    .item { grid-template-columns: auto minmax(0, 1fr); gap: 0.1rem var(--s-2); }
    .item :global(.icono) { grid-row: span 2; margin: 0.1rem 0 0; }
  }
</style>
