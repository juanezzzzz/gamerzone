---
import { Picture } from 'astro:assets'
import { COMODIDADES, COMODIDADES_FOTO, TEXTOS } from '../data/local'
import Icono from './Icono.astro'
// El panel elige el ícono por nombre; si no existe, va un check
const iconos = ['clima', 'servicio', 'silla', 'tienda', 'pisos', 'noche', 'control', 'monitor', 'grupo', 'pago'] as const
type NombreIcono = (typeof iconos)[number]
const icono = (n: string): NombreIcono | 'check' => ((iconos as readonly string[]).includes(n) ? (n as NombreIcono) : 'check')
---

<section class="comodidades claro" id="comodidades">
  <div class="contenedor">
    <header class="cabeza" data-reveal>
      <h2 class="titulo">{TEXTOS.comodidades.titulo}</h2>
      <p class="lead">{TEXTOS.comodidades.texto}</p>
    </header>

    <div class="bento">
      <figure class="foto" data-superficie="oscura" data-reveal>
        <Picture src={COMODIDADES_FOTO} alt={TEXTOS.comodidades.fotoTitulo} formats={['avif', 'webp']} fallbackFormat="webp" widths={[700, 1100, 1500]} sizes="(max-width: 47.99rem) 100vw, 50vw" />
        <figcaption>
          <Icono nombre="pisos" />
          <span>
            <strong>{TEXTOS.comodidades.fotoTitulo}</strong>
            {TEXTOS.comodidades.fotoTexto}
          </span>
        </figcaption>
      </figure>
      {
        COMODIDADES.map((c) => (
          <div class="item" data-reveal>
            <Icono nombre={icono(c.icono)} />
            <h3 class="item-titulo">{c.titulo}</h3>
            <p class:list={['item-texto', { pendiente: c.pendiente }]}>{c.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .comodidades { padding-block: var(--s-seccion); }
  .cabeza { display: grid; gap: var(--s-2); margin-bottom: var(--s-5); }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(13rem, auto);
    gap: var(--s-2);
  }
  .foto {
    position: relative;
    grid-column: span 2;
    grid-row: span 2;
    min-height: 28rem;
    overflow: hidden;
    border-radius: var(--radio-l);
    background: var(--grafito);
  }
  .foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  figcaption {
    position: absolute;
    left: var(--s-2);
    right: var(--s-2);
    bottom: var(--s-2);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radio-m);
    background: rgb(11 13 16 / 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--sobre-oscuro);
  }
  figcaption span { display: grid; color: var(--sobre-oscuro-2); }
  figcaption strong { font-weight: 700; color: var(--sobre-oscuro); }
  figcaption :global(.icono) { color: var(--acento); }

  .item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--s-4);
    border-radius: var(--radio-l);
    background: var(--blanco);
    box-shadow: var(--sombra-tarjeta);
  }
  .item :global(.icono) { width: 2rem; height: 2rem; color: var(--acento-texto); }
  .item-titulo { padding-top: var(--s-4); font: 800 var(--t-xl) / 1.1 var(--f-sans); font-stretch: 106%; }
  .item-texto { color: var(--tinta-2); }

  @media (max-width: 64rem) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .foto { grid-column: 1 / -1; grid-row: auto; min-height: 22rem; }
  }
  /* Mobile: una comodidad por fila, ícono a la izquierda */
  @media (max-width: 47.99rem) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.15rem var(--s-2); padding: var(--s-3); }
    .item :global(.icono) { grid-row: span 2; margin: 0; }
    .item-titulo { margin-top: 0; padding-top: 0; font-size: var(--t-l); }
  }
</style>
