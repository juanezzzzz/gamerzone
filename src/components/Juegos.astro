---
import { JUEGOS, TEXTOS, waLink } from '../data/local'
import Icono from './Icono.astro'
---

<section class="juegos claro" id="juegos" data-juegos>
  <!-- Transición: los nombres pasan en una fila; el scroll la acelera -->
  <div class="marquesina" aria-hidden="true">
    <div class="fila" data-fila="1">
      {[0, 1].map(() => (
        <div class="tramo">
          {JUEGOS.map((j) => (
            <span class="juego">{j.nombre}</span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- Lista consultable: responde "¿tienen mi juego?" -->
  <div class="contenedor" data-catalogo>
    <header class="cabeza-doble cabeza" data-reveal>
      <h2 class="titulo">{TEXTOS.juegos.titulo}</h2>
      <p class="lead">
        Los más pedidos ya están instalados. ¿No ves el tuyo? <a href={waLink('Hola, ¿tienen instalado este juego?')} target="_blank" rel="noopener">Escríbenos</a> y te lo dejamos listo.
      </p>
    </header>
    <div class="filtros" role="group" aria-label="Filtrar por plataforma" data-reveal>
      {[['todos', 'Todos'], ['pc', 'PC'], ['xbox', 'Xbox']].map(([v, t], i) => (
        <button type="button" class="filtro" data-filtro={v} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>
      ))}
    </div>
    <ul class="lista" data-reveal>
      {
        JUEGOS.map((j) => (
          <li class="item" data-en={j.en.join(' ')}>
            <span class="nombre">{j.nombre}</span>
            <span class="genero">{j.tag}</span>
            <span class="plataformas">
              {j.en.map((p) => (
                <span class="plataforma">
                  <Icono nombre={p === 'pc' ? 'monitor' : 'control'} />
                  {p === 'pc' ? 'PC' : 'Xbox'}
                </span>
              ))}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="nota dato">Lista de referencia. Pregunta por tu juego antes de venir.</p>
  </div>
</section>

<script>
  // Filtro por plataforma: oculta los juegos que no están en la elegida
  const catalogo = document.querySelector('[data-catalogo]')
  const botones = [...(catalogo?.querySelectorAll<HTMLButtonElement>('[data-filtro]') ?? [])]
  const items = [...(catalogo?.querySelectorAll<HTMLElement>('[data-en]') ?? [])]
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtro!
      botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
      items.forEach((i) => (i.hidden = f !== 'todos' && !i.dataset.en!.split(' ').includes(f)))
    })
  )
</script>

<style>
  .juegos { padding-block: var(--s-6) var(--s-seccion); overflow: clip; }

  .marquesina { margin-bottom: var(--s-6); }
  .fila { display: flex; width: max-content; }
  .tramo { display: flex; }
  .juego {
    padding-right: 0.6em;
    font: 800 clamp(2.5rem, 6vw, 5rem) / 1.1 var(--f-sans);
    font-stretch: var(--ancho-titulo);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .juego::after { content: '·'; padding-left: 0.6em; color: var(--acento-texto); }

  .cabeza { margin-bottom: var(--s-4); }
  .cabeza a { color: var(--acento-texto); font-weight: 600; }
  .filtros {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radio-boton);
    background: var(--linea-clara);
  }
  .filtro {
    min-height: 2.5rem;
    padding: 0 1.25rem;
    border: 0;
    border-radius: var(--radio-boton);
    background: transparent;
    color: var(--tinta-2);
    font: 600 var(--t-s) / 1 var(--f-sans);
    cursor: pointer;
  }
  .filtro:hover { color: var(--tinta); }
  .filtro[aria-pressed='true'] { background: var(--tinta); color: var(--blanco); }

  .lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s-5);
    margin-top: var(--s-3);
  }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.1rem var(--s-2);
    padding-block: 0.9rem;
    border-top: 1px solid var(--linea-clara);
  }
  .item[hidden] { display: none; }
  .nombre { font: 700 var(--t-l) / 1.2 var(--f-sans); }
  .genero { grid-row: 2; font-size: var(--t-s); color: var(--tinta-2); }
  .plataformas { grid-row: 1 / span 2; grid-column: 2; display: flex; gap: 0.4rem; }
  .plataforma {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radio-boton);
    background: var(--blanco);
    font: 600 var(--t-xs) / 1.2 var(--f-sans);
  }
  .plataforma :global(.icono) { width: 0.95rem; height: 0.95rem; color: var(--acento-texto); }
  .nota { margin-top: var(--s-3); }

  @media (max-width: 47.99rem) {
    .lista { grid-template-columns: 1fr; }
  }
  :global(.reduced) .marquesina { display: none; }
</style>
