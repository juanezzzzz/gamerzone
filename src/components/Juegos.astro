---
import { JUEGOS, waLink } from '../data/local'
// Tres filas con orden distinto para que no se lean como copia
const filas = [JUEGOS, [...JUEGOS.slice(3), ...JUEGOS.slice(0, 3)], [...JUEGOS.slice(5), ...JUEGOS.slice(0, 5)]]
---

<section class="juegos" id="juegos" data-juegos>
  <header class="cabeza">
    <p class="label">Juegos</p>
    <p class="lead">Los más pedidos ya están instalados. ¿No ves el tuyo? <a href={waLink('Hola, ¿tienen instalado este juego?')} target="_blank" rel="noopener">Escríbenos</a> y te lo dejamos listo.</p>
  </header>


  <div class="marquesina" aria-hidden="true">
    {
      filas.map((fila, i) => (
        <div class="fila" data-fila={i % 2 ? '-1' : '1'}>
          {[0, 1].map(() => (
            <div class="tramo">
              {fila.map((j) => (
                <span class="juego">
                  {j.nombre}
                  <sup class="label">{j.tag}</sup>
                </span>
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <!-- Lista consultable: la marquesina da ambiente, esta lista responde "¿tienen mi juego?" -->
  <div class="catalogo" data-catalogo>
    <div class="catalogo-cabeza">
      <h2 class="display titulo">Juegos disponibles</h2>
      <div class="filtros" role="group" aria-label="Filtrar por plataforma">
        {[['todos', 'Todos'], ['pc', 'PC'], ['xbox', 'Xbox']].map(([v, t], i) => (
          <button type="button" class="filtro" data-filtro={v} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>
        ))}
      </div>
    </div>
    <ul class="lista">
      {
        JUEGOS.map((j) => (
          <li class="item" data-en={j.en.join(' ')}>
            <span class="nombre">{j.nombre}</span>
            <span class="label genero">{j.tag}</span>
            <span class="plataformas">
              {j.en.map((p) => <span class:list={['plataforma', p]}>{p === 'pc' ? 'PC' : 'Xbox'}</span>)}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="label nota">Lista de referencia. Pregunta por tu juego antes de venir.</p>
  </div>
</section>

<script>
  // Filtro por plataforma: oculta los juegos que no están en la elegida
  const catalogo = document.querySelector('[data-catalogo]')
  const botones = [...(catalogo?.querySelectorAll<HTMLButtonElement>('[data-filtro]') ?? [])]
  const items = [...(catalogo?.querySelectorAll<HTMLElement>('[data-en]') ?? [])]
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtro!
      botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
      items.forEach((i) => (i.hidden = f !== 'todos' && !i.dataset.en!.split(' ').includes(f)))
    })
  )
</script>

<style>
  .juegos {
    padding-block: var(--s-seccion) var(--s-5);
    overflow: hidden;
    background:
      radial-gradient(ellipse 40% 50% at 85% 55%, var(--halo-magenta), transparent 70%),
      radial-gradient(ellipse 40% 50% at 10% 70%, var(--halo-cian), transparent 70%);
  }
  .cabeza {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
    padding: 0 var(--gutter) var(--s-5);
  }
  .cabeza a { color: var(--acento-activo); }

  .marquesina { display: grid; gap: var(--s-1); }
  .fila { display: flex; width: max-content; will-change: transform; }
  .tramo { display: flex; gap: var(--s-5); padding-right: var(--s-5); }
  .juego {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--s-1);
    white-space: nowrap;
    font: 800 clamp(3rem, 9vw, 9rem) / 1 var(--f-display);
    font-stretch: 58%;
    text-transform: uppercase;
  }
  .fila:nth-child(2) .juego { color: transparent; -webkit-text-stroke: 1.5px var(--acento); text-shadow: 0 0 22px rgb(47 224 255 / 0.35); }
  .fila:first-child .juego:nth-child(3n + 2) {
    background: var(--rgb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fila:nth-child(3) .juego { color: var(--texto-secundario); font-stretch: 100%; font-size: clamp(2rem, 5vw, 5rem); }
  .juego sup { padding-top: 0.6em; font-size: var(--t-xs); color: var(--acento-2); }

  .catalogo { display: grid; gap: var(--s-3); padding: var(--s-6) var(--gutter) 0; }
  .catalogo-cabeza { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-3); flex-wrap: wrap; }
  .titulo { font-size: var(--t-4xl); font-stretch: 62%; }
  .filtros { display: flex; gap: var(--s-1); }
  .filtro {
    min-height: 2.5rem;
    padding: 0 var(--s-3);
    border: 1px solid var(--linea);
    border-radius: var(--radio-boton);
    background: transparent;
    color: var(--texto-secundario);
    font: 600 var(--t-s) / 1 var(--f-body);
    cursor: pointer;
    transition: color var(--dur-micro), border-color var(--dur-micro);
  }
  .filtro:hover { color: var(--texto); }
  .filtro[aria-pressed='true'] { border-color: var(--acento); color: var(--texto); box-shadow: 0 0 18px -8px var(--acento); }
  .lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); }
  .item {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: var(--s-2);
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--linea);
  }
  .item[hidden] { display: none; }
  .nombre { font-size: var(--t-xl); }
  .genero { color: var(--texto-secundario); }
  .plataformas { display: flex; gap: 0.3rem; }
  .plataforma { padding: 0.2rem 0.45rem; border-radius: var(--radio-media); font: 600 var(--t-xs) / 1 var(--f-mono); }
  .plataforma.pc { background: rgb(47 224 255 / 0.14); color: var(--acento); }
  .plataforma.xbox { background: rgb(255 47 166 / 0.14); color: var(--acento-2); }
  .nota { color: var(--texto-secundario); }

  @media (max-width: 47.99rem) {
    .cabeza { flex-direction: column; align-items: flex-start; }
    .lista { grid-template-columns: 1fr; }
    .item { grid-template-columns: 1fr auto; }
    .genero { display: none; }
  }
  :global(.reduced) .marquesina { overflow-x: auto; }
</style>
