---
import { JUEGOS, TEXTOS, waLink } from '../data/local'
import Icono from './Icono.astro'
// Dos filas con orden distinto para que no se lean como copia
const filas = [JUEGOS, [...JUEGOS.slice(4), ...JUEGOS.slice(0, 4)]]
---

<section class="juegos" id="juegos" data-juegos>
  <!-- Ambiente: los nombres pasan en dos filas; el scroll las acelera -->
  <div class="marquesina" aria-hidden="true">
    {
      filas.map((fila, i) => (
        <div class="fila" data-fila={i % 2 ? '-1' : '1'}>
          {[0, 1].map(() => (
            <div class="tramo">
              {fila.map((j) => (
                <span class="juego">{j.nombre}</span>
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <!-- Lista consultable: responde "¿tienen mi juego?" -->
  <div class="contenedor catalogo" data-catalogo>
    <header class="cabeza" data-reveal>
      <h2 class="titulo">{TEXTOS.juegos.titulo}</h2>
      <p class="lead">
        Los más pedidos ya están instalados. ¿No ves el tuyo? <a href={waLink('Hola, ¿tienen instalado este juego?')} target="_blank" rel="noopener">Escríbenos</a> y te lo dejamos listo.
      </p>
      <div class="filtros" role="group" aria-label="Filtrar por plataforma">
        {[['todos', 'Todos'], ['pc', 'PC'], ['xbox', 'Xbox']].map(([v, t], i) => (
          <button type="button" class="filtro" data-filtro={v} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>
        ))}
      </div>
    </header>
    <ul class="lista">
      {
        JUEGOS.map((j) => (
          <li class="item" data-en={j.en.join(' ')}>
            <span class="nombre">{j.nombre}</span>
            <span class="genero">{j.tag}</span>
            <span class="plataformas">
              {j.en.map((p) => (
                <span class="plataforma">
                  <Icono nombre={p === 'pc' ? 'monitor' : 'control'} />
                  {p === 'pc' ? 'PC' : 'Xbox'}
                </span>
              ))}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="nota dato">Lista de referencia. Pregunta por tu juego antes de venir.</p>
  </div>
</section>

<script>
  // Filtro por plataforma: oculta los juegos que no están en la elegida
  const catalogo = document.querySelector('[data-catalogo]')
  const botones = [...(catalogo?.querySelectorAll<HTMLButtonElement>('[data-filtro]') ?? [])]
  const items = [...(catalogo?.querySelectorAll<HTMLElement>('[data-en]') ?? [])]
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtro!
      botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
      items.forEach((i) => (i.hidden = f !== 'todos' && !i.dataset.en!.split(' ').includes(f)))
    })
  )
</script>

<style>
  .juegos { padding-block: var(--s-seccion); overflow: clip; }

  .marquesina { display: grid; gap: 0.25rem; margin-bottom: var(--s-6); }
  .fila { display: flex; width: max-content; }
  .tramo { display: flex; }
  .juego {
    padding-right: 0.6em;
    font: 800 clamp(3rem, 8vw, 7rem) / 1.05 var(--f-sans);
    font-stretch: var(--ancho-titulo);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .juego::after { content: '·'; padding-left: 0.6em; color: var(--acento); }
  .fila:nth-child(2) .juego { color: var(--grafito-3); }
  .fila:nth-child(2) .juego::after { color: var(--grafito-3); }

  .catalogo {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--s-4) var(--s-6);
    align-items: start;
  }
  .cabeza { display: grid; gap: var(--s-2); }
  .cabeza a { color: var(--acento); }
  .filtros {
    display: inline-flex;
    justify-self: start;
    gap: 0.25rem;
    margin-top: var(--s-2);
    padding: 0.25rem;
    border-radius: var(--radio-boton);
    background: var(--grafito-2);
  }
  .filtro {
    min-height: 2.5rem;
    padding: 0 1.25rem;
    border: 0;
    border-radius: var(--radio-boton);
    background: transparent;
    color: var(--sobre-oscuro-2);
    font: 600 var(--t-s) / 1 var(--f-sans);
    cursor: pointer;
    transition: background-color var(--dur-micro), color var(--dur-micro);
  }
  .filtro:hover { color: var(--sobre-oscuro); }
  .filtro[aria-pressed='true'] { background: var(--sobre-oscuro); color: var(--grafito); }

  .lista { border-top: 1px solid var(--linea-oscura); }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--s-3);
    padding-block: 1rem;
    border-bottom: 1px solid var(--linea-oscura);
  }
  .item[hidden] { display: none; }
  .nombre { font: 700 var(--t-l) / 1.2 var(--f-sans); }
  .genero { font-size: var(--t-s); color: var(--sobre-oscuro-2); }
  .plataformas { display: flex; gap: 0.4rem; min-width: 9.5rem; justify-content: flex-end; }
  .plataforma {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radio-boton);
    background: var(--grafito-2);
    font: 600 var(--t-xs) / 1.2 var(--f-sans);
  }
  .plataforma :global(.icono) { width: 0.95rem; height: 0.95rem; color: var(--acento); }
  .nota { grid-column: 2; }

  @media (max-width: 64rem) {
    .catalogo { grid-template-columns: 1fr; }
    .nota { grid-column: 1; }
  }
  @media (max-width: 47.99rem) {
    .item { grid-template-columns: minmax(0, 1fr) auto; row-gap: 0.25rem; }
    .genero { grid-row: 2; }
    .plataformas { grid-row: 1 / span 2; grid-column: 2; min-width: 0; flex-direction: column; align-items: flex-end; }
  }
  :global(.reduced) .marquesina { display: none; }
</style>
