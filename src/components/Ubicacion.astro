---
import { NEGOCIO, HORARIO, SEDES, TEXTOS, waLink } from '../data/local'
import { formatoHora } from '../lib/horario'
import Icono from './Icono.astro'
const nombres = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']
---

<section class="ubicacion claro" id="sedes" data-ubicacion data-horario={JSON.stringify(HORARIO.dias)}>
  <div class="contenedor rejilla">
    <header class="cabeza" data-reveal>
      <h2 class="titulo">{TEXTOS.sedes.titulo}</h2>
      <p class="lead">{TEXTOS.sedes.texto}</p>
    </header>

    <!-- Las sedes, con sus dos acciones -->
    <ul class="sedes">
      {
        SEDES.map((s) => (
          <li class="sede" data-reveal>
            <Icono nombre="mapa" class="sede-icono" />
            <div class="sede-datos">
              <h3 class="sede-nombre">{s.nombre}</h3>
              <address>
                <span class:list={{ pendiente: s.direccion.pendiente }}>{s.direccion.texto}</span>
                <span class:list={['dato', { pendiente: s.barrio.pendiente }]}>
                  {s.barrio.texto} · {NEGOCIO.ciudad.texto}
                </span>
              </address>
            </div>
            <div class="acciones">
              <a class="btn" href={s.mapa} target="_blank" rel="noopener">Cómo llegar</a>
              <a class="enlace" href={waLink(`Hola, quiero reservar en GamerZone ${s.nombre}.`)} target="_blank" rel="noopener">
                Reservar aquí <Icono nombre="flecha" />
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- Estado de hoy con la hora de Colombia y el horario de la semana -->
    <div class="horario" data-superficie="oscura" data-reveal>
      <p class="estado hoy-estado" data-hoy-estado>Horario</p>
      <p class:list={['hora', { pendiente: HORARIO.pendiente }]}>
        <span class="hora-label" data-hoy-label>Abrimos a las</span>
        <span class="hora-valor" data-hoy-hora>10:00</span>
      </p>
      <dl class:list={['semana', { pendiente: HORARIO.pendiente }]}>
        {
          [1, 2, 3, 4, 5, 6, 0].map((d) => {
            const h = HORARIO.dias.find((x) => x.dia === d)
            return (
              <div class="dia" data-dia={d}>
                <dt>
                  {nombres[d]}
                  {h?.transnochon && <span class="tag">Transnochón</span>}
                </dt>
                <dd>{h ? `${formatoHora(h.abre)} – ${formatoHora(h.cierra)}` : 'Cerrado'}</dd>
              </div>
            )
          })
        }
      </dl>
      <p class="contacto">
        <Icono nombre="mensaje" />
        WhatsApp <span class:list={{ pendiente: NEGOCIO.whatsapp.pendiente }}>{NEGOCIO.whatsapp.visible}</span>
        <span aria-hidden="true">·</span>
        <a class:list={{ pendiente: NEGOCIO.instagram.pendiente }} href={`https://instagram.com/${NEGOCIO.instagram.texto.replace('@', '')}`} target="_blank" rel="noopener">{NEGOCIO.instagram.texto}</a>
      </p>
    </div>
  </div>
</section>

<script>
  import { estadoHoy, ahoraEnColombia, type DiaHorario } from '../lib/horario'
  // El estado de hoy se calcula con la hora de Colombia
  const el = document.querySelector<HTMLElement>('[data-ubicacion]')
  if (el) {
    const estado = estadoHoy(JSON.parse(el.dataset.horario || '[]') as DiaHorario[])
    el.querySelector(`[data-dia="${ahoraEnColombia().getDay()}"]`)?.classList.add('hoy')
    const badge = el.querySelector<HTMLElement>('[data-hoy-estado]')
    const label = el.querySelector('[data-hoy-label]')
    const hora = el.querySelector('[data-hoy-hora]')
    if (badge) {
      badge.textContent = estado.abierto ? 'Abierto ahora' : 'Cerrado ahora'
      badge.toggleAttribute('data-abierto', estado.abierto)
    }
    if (label) label.textContent = estado.label
    if (hora) hora.textContent = estado.hora
  }
</script>

<style>
  .ubicacion { padding-block: 0 var(--s-seccion); }
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas: 'cabeza horario' 'sedes horario';
    align-items: start;
    gap: var(--s-4) var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--linea-clara);
  }
  .cabeza { grid-area: cabeza; display: grid; gap: var(--s-2); }
  .sedes { grid-area: sedes; display: grid; gap: var(--s-2); }
  .horario { grid-area: horario; }

  .sede {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-2) var(--s-3);
    padding: var(--s-4);
    border-radius: var(--radio-l);
    background: var(--blanco);
    box-shadow: var(--sombra-tarjeta);
  }
  .sede :global(.sede-icono) { width: 1.75rem; height: 1.75rem; color: var(--acento-texto); }
  .sede-nombre { font: 800 var(--t-xl) / 1.1 var(--f-sans); font-stretch: 106%; }
  address { display: grid; gap: 0.15rem; margin-top: 0.35rem; font-style: normal; }
  .acciones { grid-column: 2; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-3); }
  .acciones .btn { min-height: 2.5rem; font-size: var(--t-s); }

  .horario {
    position: sticky;
    top: calc(var(--nav-h) + var(--s-3));
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4);
    border-radius: var(--radio-l);
    background: var(--grafito);
    color: var(--sobre-oscuro);
  }
  .hoy-estado { font: 700 var(--t-s) / 1 var(--f-sans); }
  .hora { display: grid; gap: 0.25rem; }
  .hora-label { color: var(--sobre-oscuro-2); }
  .hora-valor {
    font: 800 var(--t-4xl) / 0.95 var(--f-sans);
    font-stretch: var(--ancho-titulo);
    letter-spacing: -0.03em;
  }
  .semana { display: grid; margin-top: var(--s-2); border-top: 1px solid var(--linea-oscura); }
  .dia {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--linea-oscura);
    font-size: var(--t-s);
    color: var(--sobre-oscuro-2);
  }
  .dia dt { display: flex; align-items: center; gap: 0.5rem; }
  .dia dd { font-weight: 600; }
  .dia:global(.hoy) { color: var(--sobre-oscuro); }
  .dia:global(.hoy) dt { font-weight: 700; }
  .dia:global(.hoy) dd { color: var(--acento); }
  .tag {
    padding: 0.15rem 0.5rem;
    border-radius: var(--radio-boton);
    background: var(--grafito-3);
    font: 600 var(--t-xs) / 1.3 var(--f-sans);
    color: var(--sobre-oscuro);
  }
  .contacto {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--s-1);
    font-size: var(--t-s);
    color: var(--sobre-oscuro-2);
  }
  .contacto :global(.icono) { width: 1.1rem; height: 1.1rem; }
  .contacto a { color: var(--sobre-oscuro); }

  @media (max-width: 64rem) {
    .rejilla { grid-template-columns: 1fr; grid-template-areas: 'cabeza' 'horario' 'sedes'; }
    .horario { position: static; }
  }
  @media (max-width: 47.99rem) {
    .sede, .horario { padding: var(--s-3); }
    .sede { grid-template-columns: 1fr; }
    .acciones { grid-column: 1; }
  }
</style>
