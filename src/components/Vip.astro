---
import { Picture } from 'astro:assets'
import { VIP, waLink } from '../data/local'
---

<section class="vip" id="vip" data-vip>
  <div class="escena" data-vip-escena>
    <div class="ventana" data-vip-ventana>
      <Picture src={VIP.imagen} alt="Sala VIP con sofá y pantalla grande" formats={['avif', 'webp']} fallbackFormat="webp" widths={[800, 1400, 2000]} sizes="100vw" />
      <div class="sombra"></div>
    </div>
    <div class="centro">
      <p class="label">Acceso privado · {VIP.capacidad.texto}</p>
      <h2 class="titulo" data-vip-titulo>Sala VIP</h2>
      <p class="lema">Tu espacio. Tu juego.</p>
      <ul class="features">
        {VIP.features.map((f) => <li class="label">{f}</li>)}
      </ul>
      <p class="precio">
        Desde <span class:list={{ pendiente: VIP.precioHora.pendiente }}>{VIP.precioHora.texto}</span> <span class="label">/ hora</span>
      </p>
      <a class="btn" href={waLink('Hola, quiero reservar la sala VIP.')} target="_blank" rel="noopener">Reservar la sala VIP</a>
      <p class="label nota">Solo con reserva</p>
    </div>
  </div>
</section>

<style>
  /* Centrado minimalista: la única sección centrada, con el acento dorado */
  .escena { position: relative; height: 100svh; overflow: hidden; display: grid; place-items: center; }
  .ventana {
    position: absolute;
    inset: 0;
    clip-path: inset(24% 32% 24% 32% round var(--radio-media));
  }
  .ventana :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.3); }
  .sombra { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgb(12 9 6 / 0.35), rgb(12 9 6 / 0.85) 75%); }

  .centro {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    padding-inline: var(--gutter);
    text-align: center;
  }
  .centro > .label { color: var(--vip); }
  .titulo {
    font: 900 var(--t-mega) / 0.82 var(--f-display);
    font-stretch: 50%;
    text-transform: uppercase;
    color: var(--vip);
    white-space: nowrap;
    text-shadow: 0 0 40px rgb(232 194 126 / 0.35);
  }
  .lema { font: 600 var(--t-2xl) / 1.2 var(--f-body); color: var(--vip-2); }
  .nota { color: var(--texto-secundario); }
  .features { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-1) var(--s-4); }
  .features li { color: var(--texto); }
  .precio { font: 600 var(--t-xl) / 1 var(--f-body); }
  .vip .btn { background: linear-gradient(100deg, var(--vip), var(--vip-2)); }
  .vip .btn:hover { box-shadow: 0 0 28px -6px var(--vip); }

  @media (max-width: 47.99rem) {
    .ventana { clip-path: inset(18% 8% 40% 8% round var(--radio-media)); }
    .titulo { font-size: 26vw; }
  }
  :global(.reduced) .ventana { clip-path: none; }
  :global(.reduced) .ventana :global(img) { transform: none; }
</style>
