---
import { Picture } from 'astro:assets'
import { VIP, waLink } from '../data/local'
import Icono from './Icono.astro'
---

<section class="vip" id="vip" data-vip>
  <div class="escena" data-vip-escena>
    <div class="ventana" data-vip-ventana>
      <Picture src={VIP.imagen} alt="Sala VIP con sofá y pantalla grande" formats={['avif', 'webp']} fallbackFormat="webp" widths={[800, 1400, 2000]} sizes="100vw" />
      <div class="sombra"></div>
    </div>
    <div class="contenido" data-vip-contenido>
      <h2 class="titulo-xl">{VIP.titulo}</h2>
      <p class="lema">{VIP.lema}</p>
      <ul class="features">
        <li><Icono nombre="grupo" /><span class:list={{ pendiente: VIP.capacidad.pendiente }}>{VIP.capacidad.texto}</span></li>
        {VIP.features.map((f) => <li><Icono nombre="check" />{f}</li>)}
      </ul>
      <p class="precio">
        <span class:list={['monto', { pendiente: VIP.precioHora.pendiente }]}>{VIP.precioHora.texto}</span>
        <span class="unidad">la hora, para todo el grupo</span>
      </p>
      <a class="btn" href={waLink('Hola, quiero reservar la sala VIP.')} target="_blank" rel="noopener">Reservar la sala VIP</a>
      <p class="nota">Solo con reserva</p>
    </div>
  </div>
</section>

<style>
  .vip { background: var(--vip-noche); }
  .escena {
    position: relative;
    height: 100svh;
    min-height: 40rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* La sala entra como una ventana central y crece a sangre con el scroll */
  .ventana {
    position: absolute;
    inset: 0;
    clip-path: inset(12% 18% 12% 18% round var(--radio-l));
  }
  .ventana :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.15); }
  .sombra {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 70% at 50% 55%, rgb(15 12 8 / 0.82), rgb(15 12 8 / 0.45));
  }

  .contenido {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    padding: var(--nav-h) var(--gutter) 0;
    text-align: center;
  }
  .lema { font: 600 var(--t-xl) / 1.2 var(--f-sans); color: var(--vip); }
  .features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-1);
    font: 600 var(--t-s) / 1.3 var(--f-sans);
  }
  .features li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .features :global(.icono) { width: 1.1rem; height: 1.1rem; color: var(--vip); }
  .precio { display: grid; gap: 0.15rem; margin-top: var(--s-2); }
  .monto {
    font: 800 var(--t-precio) / 1 var(--f-sans);
    font-stretch: var(--ancho-titulo);
    letter-spacing: -0.03em;
    color: var(--vip);
  }
  .unidad { color: var(--sobre-oscuro-2); }
  .contenido .btn { margin-top: var(--s-2); background: var(--vip); color: var(--vip-noche); }
  .contenido .btn:hover { background: var(--vip-hover); }
  .nota { margin-top: 0.25rem; font-size: var(--t-s); color: var(--sobre-oscuro-2); }

  @media (max-width: 47.99rem) {
    .ventana { clip-path: inset(8% 5% 8% 5% round var(--radio-l)); }
    .features { display: grid; justify-items: center; }
  }
  :global(.reduced) .ventana { clip-path: none; }
  :global(.reduced) .ventana :global(img) { transform: none; }
</style>
