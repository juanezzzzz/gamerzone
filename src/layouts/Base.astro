---
import '../styles/global.css'
import { REVISION, NEGOCIO } from '../data/local'
import { url } from '../lib/url'

interface Props {
  title?: string
  description?: string
}
const {
  title = `${NEGOCIO.nombre} · ${NEGOCIO.lema}`,
  description = 'Sala de videojuegos en Colombia: PCs gamer, Xbox 360, One y Series S y sala VIP. Dos sedes, transnochón viernes y sábado.',
} = Astro.props
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d10" />
    {REVISION && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />
    <script is:inline>
      ;(() => {
        const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches
        document.documentElement.classList.add(reducido ? 'reduced' : 'motion')
        // La intro del logo sale una vez por visita, y no si se entra directo a una sección
        let vista = false
        try {
          vista = sessionStorage.getItem('gz-intro') === '1'
        } catch {}
        if (!reducido && !vista && !location.hash) document.documentElement.classList.add('con-intro')
      })()
    </script>
  </head>
  <body class:list={{ revision: REVISION }}>
    <slot />
    <script>
      import '../scripts/motion'
    </script>
  </body>
</html>
