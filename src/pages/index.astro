---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Apertura from '../components/Apertura.astro'
import Hero from '../components/Hero.astro'
import Pcs from '../components/Pcs.astro'
import Statement from '../components/Statement.astro'
import Consolas from '../components/Consolas.astro'
import Juegos from '../components/Juegos.astro'
import Vip from '../components/Vip.astro'
import Galeria from '../components/Galeria.astro'
import Tarifas from '../components/Tarifas.astro'
import Planes from '../components/Planes.astro'
import Lugar from '../components/Lugar.astro'
import Ubicacion from '../components/Ubicacion.astro'
import Faq from '../components/Faq.astro'
import CtaFinal from '../components/CtaFinal.astro'
import Footer from '../components/Footer.astro'
import MobileCta from '../components/MobileCta.astro'
---

<!-- El orden sigue las preguntas del visitante: qué es, cuánto cuesta, dónde queda,
     qué hay, qué juegos, planes y dudas. Lo atmosférico va al final. -->
<Base>
  <Nav />
  <main>
    <!-- Qué es -->
    <Apertura />
    <Hero />
    <!-- Cuánto cuesta y dónde queda -->
    <Tarifas />
    <Ubicacion />
    <!-- Qué hay -->
    <Pcs />
    <Consolas />
    <Vip />
    <Juegos />
    <!-- Para decidir -->
    <Planes />
    <Faq />
    <!-- Ambiente y cierre -->
    <Lugar />
    <Galeria />
    <Statement />
    <CtaFinal />
  </main>
  <Footer />
  <MobileCta />
</Base>
