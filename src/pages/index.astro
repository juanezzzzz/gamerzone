---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Apertura from '../components/Apertura.astro'
import Hero from '../components/Hero.astro'
import Precios from '../components/Precios.astro'
import Ubicacion from '../components/Ubicacion.astro'
import Pcs from '../components/Pcs.astro'
import Consolas from '../components/Consolas.astro'
import Vip from '../components/Vip.astro'
import Juegos from '../components/Juegos.astro'
import Comodidades from '../components/Comodidades.astro'
import Faq from '../components/Faq.astro'
import CtaFinal from '../components/CtaFinal.astro'
import Footer from '../components/Footer.astro'
import MobileCta from '../components/MobileCta.astro'
---

<!-- El orden sigue las preguntas del visitante: qué es, cuánto cuesta, dónde queda,
     qué hay, qué juegos, comodidades y dudas. Las secciones claras son de información. -->
<Base>
  <Nav />
  <main>
    <!-- Qué es -->
    <Apertura />
    <Hero />
    <!-- Cuánto cuesta y dónde queda -->
    <Precios />
    <Ubicacion />
    <!-- Qué hay -->
    <Pcs />
    <Consolas />
    <Vip />
    <Juegos />
    <!-- Para decidir -->
    <Comodidades />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <MobileCta />
</Base>
