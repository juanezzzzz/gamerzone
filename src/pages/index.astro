---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Apertura from '../components/Apertura.astro'
import Hero from '../components/Hero.astro'
import Precios from '../components/Precios.astro'
import Equipos from '../components/Equipos.astro'
import Vip from '../components/Vip.astro'
import Juegos from '../components/Juegos.astro'
import Comodidades from '../components/Comodidades.astro'
import Ubicacion from '../components/Ubicacion.astro'
import Faq from '../components/Faq.astro'
import CtaFinal from '../components/CtaFinal.astro'
import Footer from '../components/Footer.astro'
import MobileCta from '../components/MobileCta.astro'
---

<!-- El orden sigue las preguntas del visitante: qué es, cuánto cuesta, dónde queda, qué hay,
     qué juegos, cómo es el lugar y dudas. Las superficies se alternan para dar ritmo. -->
<Base>
  <Apertura />
  <Nav />
  <main>
    <Hero />
    <Precios />
    <Ubicacion />
    <Equipos />
    <Vip />
    <Juegos />
    <Comodidades />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <MobileCta />
</Base>
